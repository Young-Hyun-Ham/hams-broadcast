# hamgatalk@gmail.com hams-broadcast
FIREBASE_PROJECT_ID=hams-broadcast
FIREBASE_CLIENT_EMAIL=xxxxx@xxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEF+M=\n-----END PRIVATE KEY-----\n"


# 이 애플리케이션의 외부 기준 URL
NEXT_PUBLIC_APP_URL=http://localhost:3012

# HAMS SSO 서버
HAMS_OAUTH_SERVER_URL=http://localhost:3000
HAMS_OAUTH_CLIENT_ID=hams-broadcast
HAMS_OAUTH_CLIENT_SECRET=xxxxx

# 서비스마다 별도로 생성한 서버 전용 난수
HAMS_COOKIE_PREFIX=hams_broadcast
HAMS_SESSION_SECRET=xxxxx

# 선택 사항. 유효한 양의 정수가 아니면 기본값 604800(7일)을 사용한다.
HAMS_SSO_SESSION_MAX_AGE_SEC=604800

# 임시 로그인 mock data 사용 허용
