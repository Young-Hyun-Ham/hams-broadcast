---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="전체 편성 — ON AIR"
  description="국가별 오늘의 드라마 방송 편성을 방송사별로 확인하세요."
>
  <main>
    <Header activePage="schedule" />
    <section class="intro">
      <div>
        <span class="kicker">
          <i></i>
          <span data-i18n="kicker">오늘의 전체 편성</span>
        </span>
        <h1>
          <span id="country-name">대한민국</span>
          <br />
          <em data-i18n="heading">모든 이야기</em>
        </h1>
      </div>
      <div class="intro-side">
        <p data-i18n="description">
          방송사와 스트리밍 채널별로 오늘 방영되는 드라마를 확인하세요.
        </p>
        <div class="status">
          <span></span>
          <span data-i18n="auto">10분마다 자동 갱신</span>
          <b id="updated">--:--</b>
          <button id="refresh" data-i18n="refresh">
            새로고침
          </button>
          <button id="generate" class="generate" data-i18n="generate" data-admin-only hidden>
            수동 생성
          </button>
        </div>
      </div>
    </section>
    <section class="schedule" aria-live="polite">
      <div class="country-bar" aria-label="국가 선택">
        <span data-i18n="chooseCountry">국가 선택</span>
        <div id="country-buttons">
          <button data-country="KR">🇰🇷 대한민국</button>
          <button data-country="US">🇺🇸 United States</button>
          <button data-country="JP">🇯🇵 日本</button>
          <button data-country="GB">🇬🇧 United Kingdom</button>
          <button data-country="FR">🇫🇷 France</button>
          <button data-country="DE">🇩🇪 Deutschland</button>
          <button data-country="ES">🇪🇸 España</button>
          <button data-country="IT">🇮🇹 Italia</button>
        </div>
      </div>
      <div class="filter-bar">
        <h2 data-i18n="channels">방송사별 편성</h2>
        <div>
          <button class="filter active" data-network="all" data-i18n="all">
            전체
          </button>
          <span id="network-filters"></span>
        </div>
      </div>
      <div class="day-bar" aria-label="요일 선택">
        <button class="day-filter active" data-day="all">전체</button>
        <button class="day-filter" data-day="0">월</button>
        <button class="day-filter" data-day="1">화</button>
        <button class="day-filter" data-day="2">수</button>
        <button class="day-filter" data-day="3">목</button>
        <button class="day-filter" data-day="4">금</button>
        <button class="day-filter" data-day="5">토</button>
        <button class="day-filter" data-day="6">일</button>
      </div>
      <div id="loading" class="loading">
        <span></span>
        <span data-i18n="loading">편성 정보를 불러오고 있어요</span>
      </div>
      <div id="schedule-groups"></div>
      <div id="empty" class="empty" hidden>
        <strong>NO SCHEDULE</strong>
        <p data-i18n="empty">오늘 등록된 드라마 편성이 없습니다.</p>
      </div>
    </section>
    <dialog id="drama-detail" class="drama-detail">
      <button class="detail-close" id="detail-close" aria-label="닫기">×</button>
      <div class="detail-poster" id="detail-poster"></div>
      <div class="detail-copy">
        <span class="detail-network" id="detail-network"></span>
        <h2 id="detail-title"></h2>
        <div class="detail-episode"><span data-i18n="currentEpisode">현재 방영 회차</span><strong id="detail-episode"></strong></div>
        <div class="detail-credits">
          <div id="detail-directors-wrap">
            <h3>감독</h3>
            <p id="detail-directors"></p>
          </div>
          <div id="detail-characters-wrap">
            <h3>등장인물</h3>
            <ul id="detail-characters"></ul>
          </div>
        </div>
        <h3 data-i18n="synopsis">줄거리</h3>
        <p id="detail-summary"></p>
        <a id="detail-link" href="#" target="_blank" rel="noopener" data-i18n="officialPage">공식 페이지 보기</a>
      </div>
    </dialog>
    <footer>
      <a class="brand" href="/">
        <span class="live-dot"></span>ON AIR
      </a>
      <span>© 2026 HAMS BROADCAST</span>
    </footer>
  </main>
  <script>
    const countries: any = {
      KR: { ko: "대한민국", en: "South Korea", ja: "韓国", flag: "🇰🇷" },
      US: { ko: "미국", en: "United States", ja: "アメリカ", flag: "🇺🇸" },
      JP: { ko: "일본", en: "Japan", ja: "日本", flag: "🇯🇵" },
      GB: { ko: "영국", en: "United Kingdom", ja: "イギリス", flag: "🇬🇧" },
      FR: { ko: "프랑스", en: "France", ja: "フランス", flag: "🇫🇷" },
      DE: { ko: "독일", en: "Germany", ja: "ドイツ", flag: "🇩🇪" },
      ES: { ko: "스페인", en: "Spain", ja: "スペイン", flag: "🇪🇸" },
      IT: { ko: "이탈리아", en: "Italy", ja: "イタリア", flag: "🇮🇹" },
    };
    const words: any = {
      ko: {
        homeMenu: "TOP 5",
        scheduleMenu: "전체 편성",
        countryLabel: "국가 선택",
        chooseCountry: "보고 싶은 국가",
        kicker: "오늘의 전체 편성",
        heading: "모든 이야기",
        description:
          "방송사와 스트리밍 채널별로 오늘 방영되는 드라마를 확인하세요.",
        auto: "매주 월요일 00시 갱신",
        refresh: "새로고침",
        generate: "수동 생성",
        generating: "생성 중...",
        generated: "생성 완료",
        generateFailed: "생성 실패",
        channels: "방송사별 편성",
        all: "전체",
        loading: "편성 정보를 불러오고 있어요",
        empty: "오늘 등록된 드라마 편성이 없습니다.",
        noData: "현재 제공되는 편성 정보가 없습니다.",
        episodes: "편",
