      },
      en: {
        homeMenu: "TOP 5",
        scheduleMenu: "FULL SCHEDULE",
        countryLabel: "Select country",
        chooseCountry: "Choose a country",
        kicker: "TODAY'S FULL SCHEDULE",
        heading: "every story",
        description:
          "Explore every drama airing today, grouped by network and streaming service.",
        auto: "Updates every Monday at 00:00",
        refresh: "Refresh",
        generate: "Generate now",
        generating: "Generating...",
        generated: "Generated",
        generateFailed: "Generation failed",
        channels: "Schedule by network",
        all: "All",
        loading: "Loading the schedule",
        empty: "No drama schedule is available today.",
        noData: "Schedule data is not currently available.",
        episodes: "shows",
        currentEpisode: "Current episode",
        synopsis: "Synopsis",
        officialPage: "View official page",
        synopsisUnavailable: "No synopsis is currently available.",
      },
      ja: {
        homeMenu: "TOP 5",
        scheduleMenu: "全番組",
        countryLabel: "国を選択",
        chooseCountry: "国を選択",
        kicker: "本日の全番組",
        heading: "すべての物語",
        description:
          "今日放送されるドラマを放送局・配信サービス別に確認できます。",
        auto: "毎週月曜0時に更新",
        refresh: "更新",
        generate: "手動生成",
        generating: "生成中...",
        generated: "生成完了",
        generateFailed: "生成失敗",
        channels: "放送局別の番組",
        all: "すべて",
        loading: "番組情報を読み込み中",
        empty: "本日のドラマ番組はありません。",
        noData: "現在、番組情報はありません。",
        episodes: "作品",
        currentEpisode: "現在の放送回",
        synopsis: "あらすじ",
        officialPage: "公式ページを見る",
        synopsisUnavailable: "あらすじ情報はありません。",
      },
      fr: {
        homeMenu: "TOP 5",
        scheduleMenu: "PROGRAMME COMPLET",
        countryLabel: "Choisir un pays",
        chooseCountry: "Choisir un pays",
        kicker: "PROGRAMME DU JOUR",
        heading: "toutes les histoires",
        description:
          "Découvrez les séries diffusées aujourd’hui, classées par chaîne et plateforme.",
        auto: "Mise à jour chaque lundi à 00 h",
        refresh: "Actualiser",
        channels: "Programme par chaîne",
        all: "Toutes",
        loading: "Chargement du programme",
        empty: "Aucune série n’est programmée aujourd’hui.",
        noData: "Programme indisponible actuellement.",
        episodes: "séries",
        currentEpisode: "Épisode actuel",
        synopsis: "Synopsis",
        officialPage: "Voir la page officielle",
        synopsisUnavailable: "Aucun synopsis disponible.",
      },
      de: {
        homeMenu: "TOP 5",
        scheduleMenu: "GESAMTES PROGRAMM",
        countryLabel: "Land auswählen",
        chooseCountry: "Land auswählen",
        kicker: "HEUTIGES PROGRAMM",
        heading: "alle Geschichten",
        description:
          "Entdecke alle heute ausgestrahlten Serien, sortiert nach Sender und Streamingdienst.",
        auto: "Aktualisierung montags um 00:00",
        refresh: "Aktualisieren",
        channels: "Programm nach Sender",
        all: "Alle",
        loading: "Programm wird geladen",
        empty: "Heute sind keine Serien eingetragen.",
        noData: "Derzeit sind keine Programmdaten verfügbar.",
        episodes: "Serien",
        currentEpisode: "Aktuelle Folge",
        synopsis: "Handlung",
        officialPage: "Offizielle Seite öffnen",
        synopsisUnavailable: "Keine Inhaltsangabe verfügbar.",
      },
      es: {
        homeMenu: "TOP 5",
        scheduleMenu: "PROGRAMACIÓN",
        countryLabel: "Seleccionar país",
        chooseCountry: "Selecciona un país",
        kicker: "PROGRAMACIÓN DE HOY",
        heading: "todas las historias",
        description:
          "Descubre las series de hoy agrupadas por canal y plataforma.",
        auto: "Actualización cada lunes a las 00:00",
        refresh: "Actualizar",
        channels: "Programación por canal",
        all: "Todos",
        loading: "Cargando la programación",
        empty: "No hay series programadas para hoy.",
        noData: "La programación no está disponible.",
        episodes: "series",
        currentEpisode: "Episodio actual",
        synopsis: "Sinopsis",
        officialPage: "Ver página oficial",
        synopsisUnavailable: "No hay sinopsis disponible.",
      },
      it: {
        homeMenu: "TOP 5",
        scheduleMenu: "PALINSESTO",
        countryLabel: "Seleziona paese",
        chooseCountry: "Scegli un paese",
        kicker: "PALINSESTO DI OGGI",
        heading: "tutte le storie",
        description:
          "Scopri le serie in onda oggi, raggruppate per canale e piattaforma.",
        auto: "Aggiornamento ogni lunedì alle 00:00",
        refresh: "Aggiorna",
        channels: "Palinsesto per emittente",
        all: "Tutti",
        loading: "Caricamento del palinsesto",
        empty: "Nessuna serie in programma oggi.",
        noData: "Il palinsesto non è disponibile.",
        episodes: "serie",
        currentEpisode: "Episodio attuale",
        synopsis: "Trama",
        officialPage: "Vedi pagina ufficiale",
        synopsisUnavailable: "Nessuna trama disponibile.",
      },
    };
    const locale: any = (navigator.language || "ko").slice(0, 2);
    const map: any = {
      ko: "KR",
      ja: "JP",
      en: "US",
      fr: "FR",
      de: "DE",
      es: "ES",
      it: "IT",
    };
    const countryLanguages: any = {
      KR: "ko",
      US: "en",
      JP: "ja",
      GB: "en",
      FR: "fr",
      DE: "de",
      ES: "es",
      IT: "it",
    };
    const dayLabels: any = {
      ko: ["전체", "월", "화", "수", "목", "금", "토", "일"],
      en: ["All", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
      ja: ["すべて", "月", "火", "水", "木", "金", "土", "日"],
      fr: ["Tous", "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim"],
      de: ["Alle", "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"],
      es: ["Todos", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"],
      it: ["Tutti", "Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"],
    };
    let defaultCountry: any =
      localStorage.getItem("hams-broadcast-country") || map[locale] || "US";
    if (!countries[defaultCountry]) defaultCountry = "US";
    let viewingCountry: any = defaultCountry;
    let lang: any = countryLanguages[defaultCountry];
    let selectedDay: any = "all";
    let groups: any = {};
    const container: any = document.querySelector("#schedule-groups");
    const select: any = document.querySelector("#country");
    const loading: any = document.querySelector("#loading");
    const empty: any = document.querySelector("#empty");
    const detail: any = document.querySelector("#drama-detail");
    function translate() {
      document.documentElement.lang = lang;
      localStorage.setItem("hams-broadcast-locale", lang);
      document.querySelectorAll("[data-i18n]").forEach((el: any) => {
        const value = words[lang][el.dataset.i18n] || words.en[el.dataset.i18n];
        if (value) el.textContent = value;
      });
      document.querySelectorAll(".day-filter").forEach((button, index) => {
        button.textContent = dayLabels[lang][index];
      });
    }
    const safe = (value = "") =>
      String(value).replace(
        /[&<>'"]/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            "'": "&#39;",
            '"': "&quot;",
          } as Record<string, string>)[c],
      );
    const strip = (value = "") => {
      const el = document.createElement("div");
      el.innerHTML = value;
      return el.textContent?.trim() || "";
    };
    function render(filter = "all") {
      const entries = Object.entries(groups).filter(
        ([network]) => filter === "all" || network === filter,
      );
      const detailItems = entries.flatMap(([network, shows]: any[]) =>
        shows.map((show: any) => ({ ...show, network })),
      );
      empty.hidden = detailItems.length > 0;
      container.innerHTML = detailItems.length
        ? `<div class="programs">${detailItems.map((show, index) => `<button class="program-card" data-detail="${index}"><div class="thumb">${show.image ? `<img src="${safe(show.image)}" alt="" loading="lazy">` : `<span>ON AIR</span>`}<i>${safe(show.time || "--:--")}</i></div><strong class="program-network">${safe(show.network)}</strong><h4>${safe(show.name)}</h4></button>`).join("")}</div>`
        : "";
      document.querySelectorAll("[data-detail]").forEach((button: any) =>
        button.addEventListener("click", () => openDetail(detailItems[Number(button.dataset.detail)])),
      );
    }
    function openDetail(show: any) {
      document.querySelector<HTMLElement>("#detail-network")!.textContent = `${show.network} · ${show.time || ""}`;
      document.querySelector<HTMLElement>("#detail-title")!.textContent = show.name;
      document.querySelector<HTMLElement>("#detail-episode")!.textContent = show.episode || (show.rank ? `TOP ${show.rank}` : "—");
      document.querySelector<HTMLElement>("#detail-summary")!.textContent = show.summary || words[lang].synopsisUnavailable;
      const directorNames: any = Array.isArray(show.directors) ? show.directors.filter(Boolean) : [];
      const directorsWrap: any = document.querySelector("#detail-directors-wrap");
      directorsWrap.hidden = directorNames.length === 0;
      document.querySelector<HTMLElement>("#detail-directors")!.textContent = directorNames.join(", ");
      const characterItems: any = Array.isArray(show.characters) && show.characters.length
        ? show.characters.map((person: any) => ({ name: person.name, actor: person.actor, description: person.description }))
        : (show.cast || []).map((person: any) => ({ name: person.roleName, actor: person.name, description: "" }));
      const charactersWrap: any = document.querySelector("#detail-characters-wrap");
      charactersWrap.hidden = characterItems.length === 0;
      document.querySelector<HTMLElement>("#detail-characters")!.innerHTML = characterItems.map((person: any) =>
        `<li><strong>${safe(person.name || "배역 미상")}</strong>${person.actor ? `<span>${safe(person.actor)}</span>` : ""}${person.description ? `<small>${safe(person.description)}</small>` : ""}</li>`
      ).join("");
      const poster: any = document.querySelector("#detail-poster");
      poster.innerHTML = show.image ? `<img src="${safe(show.image)}" alt="${safe(show.name)}">` : `<span>${show.rank ? `TOP ${show.rank}` : "ON AIR"}</span>`;
      const link: any = document.querySelector("#detail-link");
      if (show.sourceUrl) { link.href = show.sourceUrl; link.hidden = false; } else { link.hidden = true; }
      detail.showModal();
    }
    function filters() {
      const target: any = document.querySelector("#network-filters");
      const names: any = Object.keys(groups).sort((a, b) => {
        const aNetflix = /netflix/i.test(a);
        const bNetflix = /netflix/i.test(b);
        if (aNetflix !== bNetflix) return aNetflix ? 1 : -1;
        return a.localeCompare(b);
      });
      target.innerHTML = names
        .map(
          (name: any) =>
            `<button class="filter" data-network="${safe(name)}">${safe(name)}</button>`,
        )
        .join("");
      document.querySelectorAll(".filter").forEach((button: any) =>
        button.addEventListener("click", () => {
          document
            .querySelectorAll(".filter")
            .forEach((x) => x.classList.remove("active"));
          button.classList.add("active");
          render(button.dataset.network);
        }),
      );
    }
    const dayAliases = [
      ["월", "월요일", "mon", "monday"],
      ["화", "화요일", "tue", "tuesday"],
      ["수", "수요일", "wed", "wednesday"],
      ["목", "목요일", "thu", "thursday"],
      ["금", "금요일", "fri", "friday"],
      ["토", "토요일", "sat", "saturday"],
      ["일", "일요일", "sun", "sunday"],
    ];
    function airsOnSelectedDay(show: any) {
      if (selectedDay === "all") return true;
      const aliases = dayAliases[Number(selectedDay)] || [];
      return (show.airDays || []).some((day: any) => aliases.includes(String(day).toLowerCase()));
    }
    function deduplicateShows(shows: any) {
      const unique = new Map();
      for (const show of shows) {
        const key = String(show.name || "")
          .toLocaleLowerCase()
          .replace(/^\[[^\]]+\]\s*/, "")
          .replace(/\((?:재|본|재방)?[^)]*\)/g, "")
          .replace(/\s+(?:시즌\s*)?\d+\s*(?:회|화|부)\s*$/g, "")
          .replace(/\s+/g, " ")
          .trim();
        unique.set(key, show);
      }
      return [...unique.values()];
    }
    async function load() {
      loading.hidden = false;
      empty.hidden = true;
      container.innerHTML = "";
      try {
        const response = await fetch(`/api/drama?country=${viewingCountry}`);
        if (!response.ok) throw new Error();
        const weekly = await response.json();
        groups = {};
        for (const item of weekly.items || []) {
          if (!airsOnSelectedDay(item)) continue;
          const network = item.broadcaster || "Unknown";
          if (!groups[network]) groups[network] = [];
          groups[network].push({
            ...item,
            name: item.title,
            time: [item.airDays?.join("·"), item.airTime].filter(Boolean).join(" "),
            image: item.thumbnailUrl,
            episode: item.slot,
            summary: item.characters?.map((character: any) => character.description).filter(Boolean).join(" ") || item.slot,
          });
        }
        for (const [network, shows] of Object.entries(groups)) {
          groups[network] = deduplicateShows(shows);
        }
        groups = Object.fromEntries(
          Object.entries(groups).sort((a, b) => a[0].localeCompare(b[0])),
        );
        filters();
        render();
        document.querySelector<HTMLElement>("#updated")!.textContent = weekly.generatedAt
          ? new Intl.DateTimeFormat(lang, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }).format(new Date(weekly.generatedAt))
          : "—";
      } catch (_) {
        empty.hidden = false;
      } finally {
        loading.hidden = true;
      }
    }
    function setViewingCountry(value: any) {
      viewingCountry = value;
      const option = [...select.options].find((item) => item.value === value);
      document.querySelector<HTMLElement>("#country-name")!.textContent =
        option?.text || value;
      document
        .querySelectorAll("[data-country]")
        .forEach((button: any) =>
          button.classList.toggle(
            "active",
            button.dataset.country === viewingCountry,
          ),
        );
      load();
    }
    function setDefaultCountry(value: any) {
      defaultCountry = value;
      lang = countryLanguages[defaultCountry];
      localStorage.setItem("hams-broadcast-country", defaultCountry);
      localStorage.setItem("hams-broadcast-locale", lang);
      translate();
      select.value = defaultCountry;
      document.querySelector<HTMLElement>("#country-flag")!.textContent =
        countries[defaultCountry].flag;
      setViewingCountry(defaultCountry);
    }
    select.addEventListener("change", (e: any) => setDefaultCountry(e.target.value));
    document
      .querySelectorAll("[data-country]")
      .forEach((button: any) =>
        button.addEventListener("click", () =>
          setViewingCountry(button.dataset.country),
        ),
      );
    document.querySelectorAll(".day-filter").forEach((button: any) =>
      button.addEventListener("click", () => {
        selectedDay = button.dataset.day;
        document.querySelectorAll(".day-filter").forEach((item: any) =>
          item.classList.toggle("active", item === button),
        );
        load();
      }),
    );
    document.querySelector("#refresh")?.addEventListener("click", load);
    document.querySelector("#generate")?.addEventListener("click", async (event: any) => {
      const button: any = event.currentTarget;
      button.disabled = true;
      button.textContent = words[lang].generating || words.en.generating;
      try {
        const response = await fetch("/api/drama/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ countryCode: viewingCountry }),
        });
        if (!response.ok) throw new Error();
        button.textContent = words[lang].generated || words.en.generated;
        await load();
      } catch (_) {
        button.textContent = words[lang].generateFailed || words.en.generateFailed;
      } finally {
        window.setTimeout(() => {
          button.disabled = false;
          button.textContent = words[lang].generate || words.en.generate;
        }, 1800);
      }
    });
    document.querySelector("#detail-close")?.addEventListener("click", () => detail.close());
    detail.addEventListener("click", (event: any) => { if (event.target === detail) detail.close(); });
    setDefaultCountry(defaultCountry);
  </script>
</Layout>
