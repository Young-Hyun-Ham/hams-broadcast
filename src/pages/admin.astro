---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { isAdminRequest } from "../lib/adminAuth";
import KoreanMoviePanel from "../components/admin/catalog/KoreanMoviePanel.astro";
import ForeignMoviePanel from "../components/admin/catalog/ForeignMoviePanel.astro";
import ForeignDramaPanel from "../components/admin/catalog/ForeignDramaPanel.astro";
import EntertainmentPanel from "../components/admin/catalog/EntertainmentPanel.astro";
import AnimePanel from "../components/admin/catalog/AnimePanel.astro";
import AnimeMoviePanel from "../components/admin/catalog/AnimeMoviePanel.astro";
import OldDramaPanel from "../components/admin/catalog/OldDramaPanel.astro";
import DocumentaryPanel from "../components/admin/catalog/DocumentaryPanel.astro";
import OldEntertainmentPanel from "../components/admin/catalog/OldEntertainmentPanel.astro";
import ForeignEntertainmentPanel from "../components/admin/catalog/ForeignEntertainmentPanel.astro";

if (!isAdminRequest(Astro.request)) return Astro.redirect("/");
---

<Layout title="관리자 대시보드 — ON AIR" description="콘텐츠 수집과 방송 편성 데이터를 관리합니다.">
  <main>
    <Header activePage="admin" />
    <section class="admin-head" style="display: none;">
      <div>
        <span>ADMINISTRATION</span>
        <h1>관리자 대시보드</h1>
        <p>콘텐츠 수집 주소와 드라마·애니·전체 편성표 데이터를 관리합니다.</p>
      </div>
      <label id="schedule-country-control" hidden>
        관리 국가
        <select id="admin-country">
          <option value="KR">대한민국</option><option value="US">United States</option>
          <option value="JP">日本</option><option value="GB">United Kingdom</option>
          <option value="FR">France</option><option value="DE">Deutschland</option>
          <option value="ES">España</option><option value="IT">Italia</option>
        </select>
      </label>
    </section> 

    <nav class="admin-tabs" aria-label="관리자 메뉴">
      <button type="button" class="active" data-admin-tab="dashboard">대시보드</button><button type="button" data-admin-tab="korean-movie">한국영화</button><button type="button" data-admin-tab="foreign-movie">해외영화</button><button type="button" data-admin-tab="catalog-drama">드라마</button><button type="button" data-admin-tab="foreign-drama">해외드라마</button><button type="button" data-admin-tab="entertainment">예능</button><button type="button" data-admin-tab="anime">일반애니</button><button type="button" data-admin-tab="anime-movie">극장판 애니</button><button type="button" data-admin-tab="old-drama">추억의 드라마</button><button type="button" data-admin-tab="documentary">시사/다큐</button><button type="button" data-admin-tab="old-entertainment">추억의 예능</button><button type="button" data-admin-tab="foreign-entertainment">해외(예능/다큐)</button><button type="button" data-admin-tab="schedule">전체편성</button>
    </nav>

    <section class="tab-panel dashboard-panel" id="panel-dashboard">
      <div class="section-title"><div><span>CRAWLER SOURCES</span><h2>크롤링 주소 관리</h2></div><div class="source-actions"><button type="button" class="primary" id="save-sources">설정 저장</button><p class="dashboard-message" id="source-message" role="status"></p></div></div>
      <div class="source-grid">
        <label>드라마 크롤링 주소<div><input id="source-drama" type="url" placeholder="https://example.com"><button type="button" data-validate-source="drama">검증</button></div><small data-source-status="drama"></small></label>
        <label>추억의 드라마 크롤링 주소<div><input id="source-oldDrama" type="url" placeholder="https://example.com"><button type="button" data-validate-source="oldDrama">검증</button></div><small data-source-status="oldDrama"></small></label>
        <label>예능 크롤링 주소<div><input id="source-entertainment" type="url" placeholder="https://example.com"><button type="button" data-validate-source="entertainment">검증</button></div><small data-source-status="entertainment"></small></label>
        <label>시사/다큐 크롤링 주소<div><input id="source-currentAffairs" type="url" placeholder="https://example.com"><button type="button" data-validate-source="currentAffairs">검증</button></div><small data-source-status="currentAffairs"></small></label>
        <label>추억의 예능 크롤링 주소<div><input id="source-oldEntertainment" type="url" placeholder="https://example.com"><button type="button" data-validate-source="oldEntertainment">검증</button></div><small data-source-status="oldEntertainment"></small></label>
        <label>해외드라마 크롤링 주소<div><input id="source-worldDrama" type="url" placeholder="https://example.com"><button type="button" data-validate-source="worldDrama">검증</button></div><small data-source-status="worldDrama"></small></label>
        <label>해외(예능/다큐) 크롤링 주소<div><input id="source-overseasEntertainment" type="url" placeholder="https://example.com"><button type="button" data-validate-source="overseasEntertainment">검증</button></div><small data-source-status="overseasEntertainment"></small></label>
        <label>일반애니 크롤링 주소<div><input id="source-generalAnime" type="url" placeholder="https://example.com"><button type="button" data-validate-source="generalAnime">검증</button></div><small data-source-status="generalAnime"></small></label>
        <label>극장판애니 크롤링 주소<div><input id="source-animatedMovie" type="url" placeholder="https://example.com"><button type="button" data-validate-source="animatedMovie">검증</button></div><small data-source-status="animatedMovie"></small></label>
        <label>한국영화 크롤링 주소<div><input id="source-koreanMovie" type="url" placeholder="https://example.com"><button type="button" data-validate-source="koreanMovie">검증</button></div><small data-source-status="koreanMovie"></small></label>
        <label>외국영화 크롤링 주소<div><input id="source-foreignMovie" type="url" placeholder="https://example.com"><button type="button" data-validate-source="foreignMovie">검증</button></div><small data-source-status="foreignMovie"></small></label>
      </div>
    </section>

    <KoreanMoviePanel />
    <ForeignMoviePanel />
    <section class="tab-panel catalog-admin" id="panel-catalog-drama" hidden>
      <div class="catalog-admin-head"><div><span>DRAMA CATALOG</span><h2>드라마 데이터 관리</h2><p>최신 생성 문서의 드라마를 추가, 수정하거나 삭제합니다.</p></div><button type="button" class="primary" id="generate-catalog">드라마 수동 생성</button></div>
      <div class="catalog-admin-grid">
        <form class="catalog-editor" id="catalog-form">
          <input type="hidden" id="catalog-id"><h3 id="catalog-form-title">드라마 추가</h3>
          <label>제목<input id="catalog-title" required></label>
          <label>썸네일 URL<input id="catalog-thumbnail" type="url"></label>
          <div class="fields two"><label>장르<input id="catalog-genres" placeholder="드라마, 코미디"></label><label>평점<input id="catalog-rating" type="number" min="0" max="10" step="0.1"></label></div>
          <label>줄거리<textarea id="catalog-synopsis" rows="5"></textarea></label>
          <section class="catalog-characters-field">
            <div class="catalog-characters-head"><span>등장인물</span><button type="button" id="catalog-character-add">추가</button></div>
            <div id="catalog-characters"></div>
          </section>
          <label class="check-field"><input id="catalog-updated" type="checkbox"> 업데이트 작품</label>
          <div class="form-actions"><button type="button" class="text-button" id="catalog-reset">초기화</button><button type="submit" class="primary">저장</button></div>
        </form>
        <section class="catalog-list-panel"><div class="section-title"><div><span id="catalog-document">LATEST DOCUMENT</span><h2>드라마 목록</h2></div><div class="catalog-list-tools"><strong id="catalog-total">0개</strong><button type="button" id="catalog-thumbnails-store">썸네일 이미지 저장</button><button type="button" id="catalog-characters-update-all">전체 등장인물 업데이트</button></div></div><form class="catalog-search" id="catalog-search-form"><label><span class="sr-only">드라마 제목 검색</span><input id="catalog-search-input" placeholder="드라마 제목 입력"></label><button type="submit">검색</button><button type="button" id="catalog-search-reset" hidden>전체목록</button></form><div id="catalog-admin-list" class="catalog-admin-list"></div><div class="admin-pager" id="catalog-pagination"></div></section>
      </div>
      <p class="dashboard-message" id="catalog-message" role="status"></p>
    </section>

    <ForeignDramaPanel /><EntertainmentPanel /><AnimePanel /><AnimeMoviePanel /><OldDramaPanel /><DocumentaryPanel /><OldEntertainmentPanel /><ForeignEntertainmentPanel />

    <div class="tab-panel" id="panel-schedule" hidden>

    <section class="week-panel" id="week-panel">
      <div class="section-title">
        <div><span>SAVED SCHEDULES</span><h2>주차별 편성표</h2></div>
        <div class="week-tools">
          <div class="year-field">
            <span>조회 연도</span>
            <div class="year-multiselect" id="year-filter">
              <button type="button" id="year-toggle" aria-haspopup="listbox" aria-expanded="false">
                <span id="selected-year-chips"></span><i aria-hidden="true"></i>
              </button>
              <div class="year-options" id="year-options" role="listbox" aria-multiselectable="true" hidden></div>
            </div>
            <small>여러 연도 선택 가능</small>
          </div>
          <strong id="week-count">0개 주차</strong>
        </div>
      </div>
      <div id="week-loading" class="notice">저장된 주차를 불러오는 중입니다.</div>
      <div id="week-empty" class="notice" hidden>저장된 편성표가 없습니다.</div>
      <div id="week-list" class="week-list"></div>
    </section>

    <section class="admin-grid" id="schedule-editor" hidden>
      <form id="broadcast-form" class="editor">
        <div class="section-title">
          <div><span id="form-mode">NEW PROGRAM</span><h2 id="form-title">편성 추가</h2></div>
          <button type="button" id="reset-form" class="text-button" hidden>신규 등록으로 전환</button>
        </div>
        <input id="broadcast-id" type="hidden" />
        <div class="fields two">
          <label>방송사 / 채널 <input id="broadcaster" name="broadcaster" required placeholder="예: tvN" /></label>
          <label>드라마 제목 <input id="title" name="title" required placeholder="드라마 제목" /></label>
        </div>
        <div class="fields three">
          <label>방영 시간 <input id="air-time" name="airTime" placeholder="예: 20:50" /></label>
          <label>편성 정보 <input id="slot" name="slot" placeholder="예: 월화 드라마" /></label>
          <label>방영 요일 <input id="air-days" name="airDays" placeholder="월, 화" /></label>
        </div>
        <label class="url-field">썸네일 URL <input id="thumbnail-url" name="thumbnailUrl" type="url" placeholder="https://example.com/poster.jpg" /></label>
        <div class="preview" id="thumbnail-preview">
          <img id="preview-image" alt="썸네일 미리보기" hidden />
          <span id="preview-message">썸네일 URL을 입력하면 미리보기가 표시됩니다.</span>
        </div>
        <details class="extra-fields">
          <summary><span>출연진 · 등장인물 · 감독</span><small>숨김 / 펼치기</small></summary>
          <div class="extra-content">
            <label>감독명
              <input id="directors" name="directors" placeholder="예: 홍길동, 김감독" />
              <small>여러 명은 쉼표로 구분해 주세요.</small>
            </label>
            <label>출연진
              <textarea id="cast" name="cast" rows="5" placeholder="배우명 | 극중 배역명 | 주연&#10;김배우 | 홍길동 | 주연"></textarea>
              <small>한 줄에 한 명씩 ‘배우명 | 극중 배역명 | 주연 여부’로 입력해 주세요.</small>
            </label>
            <label>등장인물
              <textarea id="characters" name="characters" rows="6" placeholder="극중 인물명 | 배우명 | 인물 설명&#10;홍길동 | 김배우 | 정의감이 강한 형사"></textarea>
              <small>한 줄에 한 명씩 ‘극중 인물명 | 배우명 | 설명’으로 입력해 주세요.</small>
            </label>
          </div>
        </details>
        <div class="form-actions">
          <span id="form-message" role="status"></span>
          <button class="primary" id="save-button" type="submit">편성 추가</button>
        </div>
      </form>

      <section class="list-panel">
        <div class="section-title">
          <div><span id="week-label">CURRENT WEEK</span><h2>저장된 편성표</h2></div>
          <div class="list-heading-actions"><strong id="item-count">0개</strong><button type="button" id="back-to-weeks">주차 목록</button></div>
        </div>
        <div id="loading" class="notice">편성표를 불러오는 중입니다.</div>
        <div id="empty" class="notice" hidden>저장된 편성이 없습니다.</div>
        <div id="broadcast-list" class="broadcast-list"></div>
      </section>
    </section>
    </div>
  </main>

  <script>
    const tabButtons = document.querySelectorAll<HTMLButtonElement>("[data-admin-tab]");
    const tabPanels = document.querySelectorAll<HTMLElement>(".tab-panel");
    const countryControl = document.querySelector<HTMLElement>("#schedule-country-control")!;
    function activateTab(name: string) {
      tabButtons.forEach((button) => button.classList.toggle("active", button.dataset.adminTab === name));
      tabPanels.forEach((panel) => { panel.hidden = panel.id !== `panel-${name}`; });
      countryControl.hidden = name !== "schedule";
      if (name === "catalog-drama") loadCatalogItems();
      document.querySelector<HTMLElement>(`#panel-${name}.catalog-module`)?.dispatchEvent(new CustomEvent("catalog:load"));
    }
    tabButtons.forEach((button) => button.addEventListener("click", () => activateTab(button.dataset.adminTab || "dashboard")));
    activateTab("dashboard");
    document.querySelectorAll<HTMLElement>(".catalog-module").forEach((panel) => {
      const generate = panel.querySelector<HTMLButtonElement>('[data-action="generate"]')!;
      const message = panel.querySelector<HTMLElement>('[data-role="message"]')!;
      const list = panel.querySelector<HTMLElement>('[data-role="list"]')!;
      const pager = panel.querySelector<HTMLElement>('[data-role="pagination"]')!;
      const queryInput = panel.querySelector<HTMLInputElement>('[data-field="query"]')!;
      const form = panel.querySelector<HTMLFormElement>('[data-role="form"]')!;
      const charactersBox = panel.querySelector<HTMLElement>('[data-role="characters"]')!;
      let page = 1; let total = 0; let query = ""; let documentId = ""; let currentItems:any[] = [];
      const field = <T extends HTMLInputElement|HTMLTextAreaElement>(name:string) => panel.querySelector<T>(`[data-field="${name}"]`)!;
      const addCharacter = (person:any={}) => {const row=document.createElement("div");row.className="catalog-character-row";row.innerHTML=`<div class="catalog-character-names"><label><span>이름</span><input data-character-name value="${escapeHtml(person.name||"")}"></label><label><span>배우 이름</span><input data-character-actor value="${escapeHtml(person.actor||"")}"></label></div><label class="catalog-character-image"><span>이미지 URL</span><input data-character-image type="url" value="${escapeHtml(person.imageUrl||"")}"></label><button type="button" class="danger" data-character-remove>삭제</button>`;row.querySelector("[data-character-remove]")!.addEventListener("click",()=>row.remove());charactersBox.append(row);};
      const resetForm = () => {form.reset();charactersBox.replaceChildren();field("id").value="";panel.querySelector<HTMLElement>('[data-role="form-title"]')!.textContent=`${panel.dataset.catalogTitle} 추가`;};
      const editItem = (item:any) => {field("id").value=item.id;field("title").value=item.title||"";field("thumbnailUrl").value=item.thumbnailUrl||"";field("genres").value=(item.genres||[]).join(", ");field("rating").value=item.rating==null?"":String(item.rating);field("synopsis").value=item.synopsis||"";field<HTMLInputElement>("isUpdated").checked=Boolean(item.isUpdated);charactersBox.replaceChildren();(item.characters||[]).forEach(addCharacter);panel.querySelector<HTMLElement>('[data-role="form-title"]')!.textContent=`${panel.dataset.catalogTitle} 수정`;form.scrollIntoView({behavior:"smooth",block:"start"});};
      const load = async () => {
        list.innerHTML='<div class="notice">목록을 불러오는 중입니다.</div>';
        try {
          const category=panel.dataset.catalogCategory||"";const response=await fetch(`/api/admin/catalog-items?category=${encodeURIComponent(category)}&page=${page}&q=${encodeURIComponent(query)}`);const data=await response.json();if(!response.ok)throw new Error(data.error);
          total=data.total||0;documentId=data.documentId||"";currentItems=data.items||[];panel.querySelector<HTMLElement>('[data-role="document"]')!.textContent=query?`SEARCH · ${query}`:(documentId||"LATEST DOCUMENT");panel.querySelector<HTMLElement>('[data-role="total"]')!.textContent=`${total}개`;panel.querySelector<HTMLButtonElement>('[data-action="search-reset"]')!.hidden=!query;
          list.innerHTML=currentItems.map((item:any)=>`<article><div class="catalog-row-thumb">${item.thumbnailUrl?`<img src="${escapeHtml(item.thumbnailUrl)}" alt="">`:"NO IMAGE"}</div><div><h3>${escapeHtml(item.title||"제목 없음")}</h3><p>${(item.genres||[]).map(escapeHtml).join(" · ")}</p></div><span>${item.rating==null?"-":`★ ${item.rating}`}</span><div class="catalog-character-status">${item.characters?.length?`<span>등장인물 ${item.characters.length}명</span>`:`<button type="button" data-module-character-update="${escapeHtml(item.id)}">UPDATE</button>`}</div><div><button type="button" data-module-edit="${escapeHtml(item.id)}">수정</button><button type="button" class="danger" data-module-delete="${escapeHtml(item.id)}">삭제</button></div></article>`).join("")||'<div class="notice">저장된 데이터가 없습니다.</div>';
          list.querySelectorAll<HTMLButtonElement>("[data-module-edit]").forEach(button=>button.addEventListener("click",()=>{const item=currentItems.find(value=>value.id===button.dataset.moduleEdit);if(item)editItem(item);}));list.querySelectorAll<HTMLButtonElement>("[data-module-delete]").forEach(button=>button.addEventListener("click",async()=>{const item=currentItems.find(value=>value.id===button.dataset.moduleDelete);if(!item||!confirm(`‘${item.title}’ 항목을 삭제할까요?`))return;const response=await fetch("/api/admin/catalog-items",{method:"DELETE",headers:{"Content-Type":"application/json"},body:JSON.stringify({category:panel.dataset.catalogCategory,documentId,id:item.id})});const data=await response.json();if(!response.ok)return alert(data.error);await load();}));list.querySelectorAll<HTMLButtonElement>("[data-module-character-update]").forEach(button=>button.addEventListener("click",async()=>{button.disabled=true;button.textContent="UPDATING...";try{const response=await fetch("/api/admin/catalog-characters",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({category:panel.dataset.catalogCategory,documentId,itemId:button.dataset.moduleCharacterUpdate})});const data=await response.json();if(!response.ok)throw new Error(data.error);message.textContent=`등장인물 업데이트 완료 · 성공 ${data.updated}개 · 실패 ${data.failed}개`;await load();}catch(error){message.textContent=error instanceof Error?error.message:"등장인물 업데이트에 실패했습니다.";button.disabled=false;button.textContent="UPDATE";}}));
          const pages=Math.max(1,Math.ceil(total/10));if(page>pages)page=pages;const start=Math.max(1,Math.min(page-7,pages-14));const end=Math.min(pages,start+14);const numbers=Array.from({length:end-start+1},(_,i)=>start+i);pager.innerHTML=`<button type="button" data-page="${Math.max(1,page-1)}" ${page===1?"disabled":""}>이전</button>${numbers.map(value=>`<button type="button" data-page="${value}" class="${value===page?"active":""}" ${value===page?'aria-current="page"':""}>${value}</button>`).join("")}<button type="button" data-page="${Math.min(pages,page+1)}" ${page===pages?"disabled":""}>다음</button>`;pager.querySelectorAll<HTMLButtonElement>("[data-page]").forEach(button=>button.addEventListener("click",()=>{const next=Number(button.dataset.page);if(next!==page){page=next;load();}}));
        } catch(error){list.innerHTML=`<div class="notice">${escapeHtml(error instanceof Error?error.message:"목록을 불러오지 못했습니다.")}</div>`;}
      };
      panel.addEventListener("catalog:load",load);
      panel.querySelector<HTMLFormElement>('[data-role="search"]')!.addEventListener("submit",event=>{event.preventDefault();query=queryInput.value.trim();page=1;load();});
      panel.querySelector<HTMLButtonElement>('[data-action="search-reset"]')!.addEventListener("click",()=>{query="";queryInput.value="";page=1;load();});
      panel.querySelector<HTMLButtonElement>('[data-action="character-add"]')!.addEventListener("click",()=>addCharacter());
      panel.querySelector<HTMLButtonElement>('[data-action="reset"]')!.addEventListener("click",resetForm);
