      idInput.value = item.id; broadcaster.value = item.broadcaster || ""; title.value = item.title || "";
      airTime.value = item.airTime || ""; slot.value = item.slot || ""; airDays.value = (item.airDays || []).join(", ");
      thumbnailUrl.value = item.thumbnailUrl || ""; resetButton.hidden = false;
      directors.value = (item.directors || []).join(", ");
      cast.value = (item.cast || []).map((person) => [person.name, person.roleName, person.isLead ? "주연" : ""].join(" | ")).join("\n");
      characters.value = (item.characters || []).map((person) => [person.name, person.actor, person.description].join(" | ")).join("\n");
      extraDetails.open = true;
      document.querySelector("#form-mode")!.textContent = "EDIT PROGRAM";
      document.querySelector("#form-title")!.textContent = "편성 수정";
      document.querySelector("#save-button")!.textContent = "변경사항 저장";
      updatePreview(); form.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function render() {
      document.querySelector("#item-count")!.textContent = `${items.length}개`;
      empty.hidden = items.length !== 0;
      list.innerHTML = items.map((item) => `<article class="broadcast-row">
        <div class="row-thumb">${item.thumbnailUrl ? `<img src="${escapeHtml(item.thumbnailUrl)}" alt="">` : "<span>NO IMAGE</span>"}</div>
        <div class="row-copy"><span>${escapeHtml(item.broadcaster || "미지정")}</span><h3>${escapeHtml(item.title || "제목 없음")}</h3><p>${escapeHtml([item.airDays?.join("·"), item.airTime, item.slot].filter(Boolean).join(" · "))}</p></div>
        <div class="row-actions"><button type="button" data-edit="${item.id}">수정</button><button type="button" class="danger" data-delete="${item.id}">삭제</button></div>
      </article>`).join("");
      list.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((button) => button.addEventListener("click", () => { const item = items.find((value) => value.id === button.dataset.edit); if (item) edit(item); }));
      list.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((button) => button.addEventListener("click", () => remove(button.dataset.delete || "")));
    }

    function scheduleYear(schedule: { docId: string; week: string }) {
      return (schedule.week.match(/^\d{4}/)?.[0] || schedule.docId.match(/_(\d{4})/)?.[1] || "기타");
    }

    function renderWeeks() {
      const selectedYears = new Set(Array.from(yearOptions.querySelectorAll<HTMLInputElement>("input:checked"), (input) => input.value));
      selectedYearChips.innerHTML = [...selectedYears].sort((a, b) => a.localeCompare(b)).map((year) => `<b>${escapeHtml(year)}년</b>`).join("") || "<em>연도 선택</em>";
      const filtered = schedules.filter((schedule) => selectedYears.has(scheduleYear(schedule)));
      document.querySelector("#week-count")!.textContent = `${filtered.length}개 주차`;
      weekEmpty.hidden = filtered.length !== 0;
      if (!filtered.length) {
        weekEmpty.textContent = "선택한 연도에 저장된 편성표가 없습니다.";
        weekList.innerHTML = "";
        return;
      }
      const groups = filtered.reduce<Record<string, typeof schedules>>((result, schedule) => {
        const year = scheduleYear(schedule);
        (result[year] ||= []).push(schedule);
        return result;
      }, {});
      weekList.innerHTML = Object.keys(groups).sort((a, b) => b.localeCompare(a)).map((year) => `<section class="year-group"><h3><span>${escapeHtml(year)}</span>년</h3><div>${groups[year].map((schedule) => `<button type="button" class="week-card" data-doc-id="${escapeHtml(schedule.docId)}"><span>${escapeHtml(countryCode())}</span><strong>${escapeHtml(schedule.week)}</strong><small>${schedule.itemCount}개 편성${schedule.createdAt ? ` · ${new Date(schedule.createdAt).toLocaleDateString("ko-KR")}` : ""}</small><i>관리하기 →</i></button>`).join("")}</div></section>`).join("");
      weekList.querySelectorAll<HTMLButtonElement>("[data-doc-id]").forEach((button) => button.addEventListener("click", () => loadSchedule(button.dataset.docId || "")));
    }

    async function loadWeeks() {
      selectedDocId = ""; weekPanel.hidden = false; scheduleEditor.hidden = true;
      weekLoading.hidden = false; weekEmpty.hidden = true; weekList.innerHTML = "";
      try {
        const response = await fetch(`/api/admin/broadcasts?country=${countryCode()}`);
        const data = await response.json(); if (!response.ok) throw new Error(data.error);
        schedules = data.schedules || [];
        const currentYear = String(new Date().getFullYear());
        const years = Array.from({ length: 2099 - 2026 + 1 }, (_, index) => String(2026 + index));
        yearOptions.innerHTML = years.map((year) => `<label role="option"><input type="checkbox" value="${year}"${year === currentYear ? " checked" : ""}><span>${year}년</span></label>`).join("");
        renderWeeks();
      } catch (error) { weekEmpty.hidden = false; weekEmpty.textContent = error instanceof Error ? error.message : "주차 목록을 불러오지 못했습니다."; }
      finally { weekLoading.hidden = true; }
    }

    async function loadSchedule(docId = selectedDocId) {
      selectedDocId = docId; if (!selectedDocId) return;
      weekPanel.hidden = true; scheduleEditor.hidden = false;
      loading.hidden = false; empty.hidden = true; list.innerHTML = "";
      try {
        const response = await fetch(`/api/admin/broadcasts?country=${countryCode()}&docId=${encodeURIComponent(selectedDocId)}`);
        const data = await response.json(); if (!response.ok) throw new Error(data.error);
        items = data.items || []; document.querySelector("#week-label")!.textContent = `${data.countryCode} · ${data.week}`; render();
      } catch (error) {
        items = [];
        empty.hidden = false;
        empty.textContent = error instanceof Error ? error.message : "목록을 불러오지 못했습니다.";
      }
      finally { loading.hidden = true; }
    }

    async function remove(id: string) {
      const item = items.find((value) => value.id === id);
      if (!item || !confirm(`‘${item.title}’ 편성을 삭제할까요?`)) return;
      const response = await fetch("/api/admin/broadcasts", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ countryCode: countryCode(), docId: selectedDocId, id }) });
      const data = await response.json(); if (!response.ok) return alert(data.error || "삭제하지 못했습니다.");
      if (idInput.value === id) resetForm(); await loadSchedule();
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault(); const button = document.querySelector<HTMLButtonElement>("#save-button")!; button.disabled = true; message.textContent = "저장 중입니다.";
      const body = {
        countryCode: countryCode(), docId: selectedDocId, id: idInput.value || undefined, broadcaster: broadcaster.value, title: title.value,
        airTime: airTime.value, slot: slot.value, airDays: airDays.value.split(",").map((value) => value.trim()).filter(Boolean), thumbnailUrl: thumbnailUrl.value,
        directors: directors.value.split(",").map((value) => value.trim()).filter(Boolean),
        cast: cast.value.split("\n").map((line) => { const [name = "", roleName = "", lead = ""] = line.split("|").map((value) => value.trim()); return { name, roleName, isLead: /^(주연|yes|true|y|1)$/i.test(lead) }; }).filter((person) => person.name),
        characters: characters.value.split("\n").map((line) => { const [name = "", actor = "", ...description] = line.split("|").map((value) => value.trim()); return { name, actor, description: description.join(" | ") }; }).filter((person) => person.name || person.actor),
      };
      try {
        const response = await fetch("/api/admin/broadcasts", { method: idInput.value ? "PATCH" : "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
        const data = await response.json(); if (!response.ok) throw new Error(data.error);
        resetForm(); message.textContent = "저장되었습니다."; await loadSchedule();
      } catch (error) { message.textContent = error instanceof Error ? error.message : "저장하지 못했습니다."; }
      finally { button.disabled = false; }
    });
    resetButton.addEventListener("click", resetForm);
    yearToggle.addEventListener("click", () => {
      const willOpen = yearOptions.hidden;
      yearOptions.hidden = !willOpen;
      yearToggle.setAttribute("aria-expanded", String(willOpen));
    });
    yearOptions.addEventListener("change", renderWeeks);
    document.addEventListener("click", (event) => {
      if (!yearFilter.contains(event.target as Node)) {
        yearOptions.hidden = true;
        yearToggle.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        yearOptions.hidden = true;
        yearToggle.setAttribute("aria-expanded", "false");
      }
    });
    document.querySelector("#back-to-weeks")!.addEventListener("click", () => { resetForm(); loadWeeks(); });
    country?.addEventListener("change", () => { resetForm(); loadWeeks(); });
    loadWeeks();
  </script>
</Layout>

