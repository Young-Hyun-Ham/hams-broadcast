---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { isAdminRequest } from "../lib/adminAuth";

if (!isAdminRequest(Astro.request)) return Astro.redirect("/");
---

<Layout title="방송 편성 관리 — ON AIR" description="저장된 방송 편성표를 관리합니다.">
  <main>
    <Header activePage="admin" />
    <section class="admin-head">
      <div>
        <span>ADMINISTRATION</span>
        <h1>방송 편성 관리</h1>
        <p>현재 주차에 저장된 드라마 편성을 추가, 수정하거나 삭제합니다.</p>
      </div>
      <label>
        관리 국가
        <select id="admin-country">
          <option value="KR">대한민국</option><option value="US">United States</option>
          <option value="JP">日本</option><option value="GB">United Kingdom</option>
          <option value="FR">France</option><option value="DE">Deutschland</option>
          <option value="ES">España</option><option value="IT">Italia</option>
        </select>
      </label>
    </section>

    <section class="week-panel" id="week-panel">
      <div class="section-title">
        <div><span>SAVED SCHEDULES</span><h2>주차별 편성표</h2></div>
        <div class="week-tools">
          <div class="year-field">
            <span>조회 연도</span>
            <div class="year-multiselect" id="year-filter">
              <button type="button" id="year-toggle" aria-haspopup="listbox" aria-expanded="false">
                <span id="selected-year-chips"></span><i aria-hidden="true"></i>
              </button>
              <div class="year-options" id="year-options" role="listbox" aria-multiselectable="true" hidden></div>
            </div>
            <small>여러 연도 선택 가능</small>
          </div>
          <strong id="week-count">0개 주차</strong>
        </div>
      </div>
      <div id="week-loading" class="notice">저장된 주차를 불러오는 중입니다.</div>
      <div id="week-empty" class="notice" hidden>저장된 편성표가 없습니다.</div>
      <div id="week-list" class="week-list"></div>
    </section>

    <section class="admin-grid" id="schedule-editor" hidden>
      <form id="drama-form" class="editor">
        <div class="section-title">
          <div><span id="form-mode">NEW PROGRAM</span><h2 id="form-title">편성 추가</h2></div>
          <button type="button" id="reset-form" class="text-button" hidden>신규 등록으로 전환</button>
        </div>
        <input id="drama-id" type="hidden" />
        <div class="fields two">
          <label>방송사 / 채널 <input id="broadcaster" name="broadcaster" required placeholder="예: tvN" /></label>
          <label>드라마 제목 <input id="title" name="title" required placeholder="드라마 제목" /></label>
        </div>
        <div class="fields three">
          <label>방영 시간 <input id="air-time" name="airTime" placeholder="예: 20:50" /></label>
          <label>편성 정보 <input id="slot" name="slot" placeholder="예: 월화 드라마" /></label>
          <label>방영 요일 <input id="air-days" name="airDays" placeholder="월, 화" /></label>
        </div>
        <label class="url-field">썸네일 URL <input id="thumbnail-url" name="thumbnailUrl" type="url" placeholder="https://example.com/poster.jpg" /></label>
        <div class="preview" id="thumbnail-preview">
          <img id="preview-image" alt="썸네일 미리보기" hidden />
          <span id="preview-message">썸네일 URL을 입력하면 미리보기가 표시됩니다.</span>
        </div>
        <details class="extra-fields">
          <summary><span>출연진 · 등장인물 · 감독</span><small>숨김 / 펼치기</small></summary>
          <div class="extra-content">
            <label>감독명
              <input id="directors" name="directors" placeholder="예: 홍길동, 김감독" />
              <small>여러 명은 쉼표로 구분해 주세요.</small>
            </label>
            <label>출연진
              <textarea id="cast" name="cast" rows="5" placeholder="배우명 | 극중 배역명 | 주연&#10;김배우 | 홍길동 | 주연"></textarea>
              <small>한 줄에 한 명씩 ‘배우명 | 극중 배역명 | 주연 여부’로 입력해 주세요.</small>
            </label>
            <label>등장인물
              <textarea id="characters" name="characters" rows="6" placeholder="극중 인물명 | 배우명 | 인물 설명&#10;홍길동 | 김배우 | 정의감이 강한 형사"></textarea>
              <small>한 줄에 한 명씩 ‘극중 인물명 | 배우명 | 설명’으로 입력해 주세요.</small>
            </label>
          </div>
        </details>
        <div class="form-actions">
          <span id="form-message" role="status"></span>
          <button class="primary" id="save-button" type="submit">편성 추가</button>
        </div>
      </form>

      <section class="list-panel">
        <div class="section-title">
          <div><span id="week-label">CURRENT WEEK</span><h2>저장된 편성표</h2></div>
          <div class="list-heading-actions"><strong id="item-count">0개</strong><button type="button" id="back-to-weeks">주차 목록</button></div>
        </div>
        <div id="loading" class="notice">편성표를 불러오는 중입니다.</div>
        <div id="empty" class="notice" hidden>저장된 편성이 없습니다.</div>
        <div id="drama-list" class="drama-list"></div>
      </section>
    </section>
  </main>

  <script>
    type CastMember = { name?: string; roleName?: string; isLead?: boolean };
    type Character = { name?: string; actor?: string; description?: string };
    type Drama = { id: string; broadcaster?: string; title?: string; slot?: string; airDays?: string[]; airTime?: string; thumbnailUrl?: string; directors?: string[]; cast?: CastMember[]; characters?: Character[] };
    const country = document.querySelector<HTMLSelectElement>("#admin-country")!;
    const weekPanel = document.querySelector<HTMLElement>("#week-panel")!;
    const scheduleEditor = document.querySelector<HTMLElement>("#schedule-editor")!;
    const weekList = document.querySelector<HTMLElement>("#week-list")!;
    const weekLoading = document.querySelector<HTMLElement>("#week-loading")!;
    const weekEmpty = document.querySelector<HTMLElement>("#week-empty")!;
    const yearFilter = document.querySelector<HTMLElement>("#year-filter")!;
    const yearToggle = document.querySelector<HTMLButtonElement>("#year-toggle")!;
    const yearOptions = document.querySelector<HTMLElement>("#year-options")!;
    const selectedYearChips = document.querySelector<HTMLElement>("#selected-year-chips")!;
    const form = document.querySelector<HTMLFormElement>("#drama-form")!;
    const idInput = document.querySelector<HTMLInputElement>("#drama-id")!;
    const broadcaster = document.querySelector<HTMLInputElement>("#broadcaster")!;
    const title = document.querySelector<HTMLInputElement>("#title")!;
    const airTime = document.querySelector<HTMLInputElement>("#air-time")!;
    const slot = document.querySelector<HTMLInputElement>("#slot")!;
    const airDays = document.querySelector<HTMLInputElement>("#air-days")!;
    const thumbnailUrl = document.querySelector<HTMLInputElement>("#thumbnail-url")!;
    const directors = document.querySelector<HTMLInputElement>("#directors")!;
    const cast = document.querySelector<HTMLTextAreaElement>("#cast")!;
    const characters = document.querySelector<HTMLTextAreaElement>("#characters")!;
    const extraDetails = document.querySelector<HTMLDetailsElement>(".extra-fields")!;
    const previewImage = document.querySelector<HTMLImageElement>("#preview-image")!;
    const previewMessage = document.querySelector<HTMLElement>("#preview-message")!;
    const list = document.querySelector<HTMLElement>("#drama-list")!;
    const loading = document.querySelector<HTMLElement>("#loading")!;
    const empty = document.querySelector<HTMLElement>("#empty")!;
    const message = document.querySelector<HTMLElement>("#form-message")!;
    const resetButton = document.querySelector<HTMLButtonElement>("#reset-form")!;
    let items: Drama[] = [];
    let selectedDocId = "";
    let schedules: Array<{ docId: string; week: string; itemCount: number; createdAt?: string | null }> = [];

    const escapeHtml = (value = "") => value.replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[char] || char);

    function updatePreview() {
      const value = thumbnailUrl.value.trim();
      previewImage.hidden = true;
      previewImage.removeAttribute("src");
      previewMessage.hidden = false;
      previewMessage.textContent = value ? "이미지를 불러오는 중입니다." : "썸네일 URL을 입력하면 미리보기가 표시됩니다.";
      if (value) previewImage.src = value;
    }
    previewImage.addEventListener("load", () => { previewImage.hidden = false; previewMessage.hidden = true; });
    previewImage.addEventListener("error", () => { previewImage.hidden = true; previewMessage.hidden = false; previewMessage.textContent = "이미지를 불러올 수 없습니다. URL을 확인해 주세요."; });
    thumbnailUrl.addEventListener("input", updatePreview);

    function resetForm() {
      form.reset(); idInput.value = ""; resetButton.hidden = true;
      document.querySelector("#form-mode")!.textContent = "NEW PROGRAM";
      document.querySelector("#form-title")!.textContent = "편성 추가";
      document.querySelector("#save-button")!.textContent = "편성 추가";
      extraDetails.open = false; message.textContent = ""; updatePreview();
    }

    function edit(item: Drama) {
      idInput.value = item.id; broadcaster.value = item.broadcaster || ""; title.value = item.title || "";
      airTime.value = item.airTime || ""; slot.value = item.slot || ""; airDays.value = (item.airDays || []).join(", ");
      thumbnailUrl.value = item.thumbnailUrl || ""; resetButton.hidden = false;
      directors.value = (item.directors || []).join(", ");
      cast.value = (item.cast || []).map((person) => [person.name, person.roleName, person.isLead ? "주연" : ""].join(" | ")).join("\n");
      characters.value = (item.characters || []).map((person) => [person.name, person.actor, person.description].join(" | ")).join("\n");
      extraDetails.open = true;
      document.querySelector("#form-mode")!.textContent = "EDIT PROGRAM";
      document.querySelector("#form-title")!.textContent = "편성 수정";
      document.querySelector("#save-button")!.textContent = "변경사항 저장";
      updatePreview(); form.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function render() {
      document.querySelector("#item-count")!.textContent = `${items.length}개`;
      empty.hidden = items.length !== 0;
      list.innerHTML = items.map((item) => `<article class="drama-row">
        <div class="row-thumb">${item.thumbnailUrl ? `<img src="${escapeHtml(item.thumbnailUrl)}" alt="">` : "<span>NO IMAGE</span>"}</div>
        <div class="row-copy"><span>${escapeHtml(item.broadcaster || "미지정")}</span><h3>${escapeHtml(item.title || "제목 없음")}</h3><p>${escapeHtml([item.airDays?.join("·"), item.airTime, item.slot].filter(Boolean).join(" · "))}</p></div>
        <div class="row-actions"><button type="button" data-edit="${item.id}">수정</button><button type="button" class="danger" data-delete="${item.id}">삭제</button></div>
      </article>`).join("");
      list.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((button) => button.addEventListener("click", () => { const item = items.find((value) => value.id === button.dataset.edit); if (item) edit(item); }));
      list.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((button) => button.addEventListener("click", () => remove(button.dataset.delete || "")));
    }

    function scheduleYear(schedule: { docId: string; week: string }) {
      return (schedule.week.match(/^\d{4}/)?.[0] || schedule.docId.match(/_(\d{4})/)?.[1] || "기타");
    }

    function renderWeeks() {
      const selectedYears = new Set(Array.from(yearOptions.querySelectorAll<HTMLInputElement>("input:checked"), (input) => input.value));
      selectedYearChips.innerHTML = [...selectedYears].sort((a, b) => a.localeCompare(b)).map((year) => `<b>${escapeHtml(year)}년</b>`).join("") || "<em>연도 선택</em>";
      const filtered = schedules.filter((schedule) => selectedYears.has(scheduleYear(schedule)));
      document.querySelector("#week-count")!.textContent = `${filtered.length}개 주차`;
      weekEmpty.hidden = filtered.length !== 0;
      if (!filtered.length) {
        weekEmpty.textContent = "선택한 연도에 저장된 편성표가 없습니다.";
        weekList.innerHTML = "";
        return;
      }
      const groups = filtered.reduce<Record<string, typeof schedules>>((result, schedule) => {
        const year = scheduleYear(schedule);
        (result[year] ||= []).push(schedule);
        return result;
      }, {});
      weekList.innerHTML = Object.keys(groups).sort((a, b) => b.localeCompare(a)).map((year) => `<section class="year-group"><h3><span>${escapeHtml(year)}</span>년</h3><div>${groups[year].map((schedule) => `<button type="button" class="week-card" data-doc-id="${escapeHtml(schedule.docId)}"><span>${escapeHtml(country.value)}</span><strong>${escapeHtml(schedule.week)}</strong><small>${schedule.itemCount}개 편성${schedule.createdAt ? ` · ${new Date(schedule.createdAt).toLocaleDateString("ko-KR")}` : ""}</small><i>관리하기 →</i></button>`).join("")}</div></section>`).join("");
      weekList.querySelectorAll<HTMLButtonElement>("[data-doc-id]").forEach((button) => button.addEventListener("click", () => loadSchedule(button.dataset.docId || "")));
    }

    async function loadWeeks() {
      selectedDocId = ""; weekPanel.hidden = false; scheduleEditor.hidden = true;
      weekLoading.hidden = false; weekEmpty.hidden = true; weekList.innerHTML = "";
      try {
        const response = await fetch(`/api/admin/dramas?country=${country.value}`);
        const data = await response.json(); if (!response.ok) throw new Error(data.error);
        schedules = data.schedules || [];
        const currentYear = String(new Date().getFullYear());
        const years = Array.from({ length: 2099 - 2026 + 1 }, (_, index) => String(2026 + index));
        yearOptions.innerHTML = years.map((year) => `<label role="option"><input type="checkbox" value="${year}"${year === currentYear ? " checked" : ""}><span>${year}년</span></label>`).join("");
        renderWeeks();
      } catch (error) { weekEmpty.hidden = false; weekEmpty.textContent = error instanceof Error ? error.message : "주차 목록을 불러오지 못했습니다."; }
      finally { weekLoading.hidden = true; }
    }

    async function loadSchedule(docId = selectedDocId) {
      selectedDocId = docId; if (!selectedDocId) return;
      weekPanel.hidden = true; scheduleEditor.hidden = false;
      loading.hidden = false; empty.hidden = true; list.innerHTML = "";
      try {
        const response = await fetch(`/api/admin/dramas?country=${country.value}&docId=${encodeURIComponent(selectedDocId)}`);
        const data = await response.json(); if (!response.ok) throw new Error(data.error);
        items = data.items || []; document.querySelector("#week-label")!.textContent = `${data.countryCode} · ${data.week}`; render();
      } catch (error) {
        items = [];
        empty.hidden = false;
        empty.textContent = error instanceof Error ? error.message : "목록을 불러오지 못했습니다.";
      }
      finally { loading.hidden = true; }
    }

    async function remove(id: string) {
      const item = items.find((value) => value.id === id);
      if (!item || !confirm(`‘${item.title}’ 편성을 삭제할까요?`)) return;
      const response = await fetch("/api/admin/dramas", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ countryCode: country.value, docId: selectedDocId, id }) });
      const data = await response.json(); if (!response.ok) return alert(data.error || "삭제하지 못했습니다.");
      if (idInput.value === id) resetForm(); await loadSchedule();
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault(); const button = document.querySelector<HTMLButtonElement>("#save-button")!; button.disabled = true; message.textContent = "저장 중입니다.";
      const body = {
        countryCode: country.value, docId: selectedDocId, id: idInput.value || undefined, broadcaster: broadcaster.value, title: title.value,
        airTime: airTime.value, slot: slot.value, airDays: airDays.value.split(",").map((value) => value.trim()).filter(Boolean), thumbnailUrl: thumbnailUrl.value,
        directors: directors.value.split(",").map((value) => value.trim()).filter(Boolean),
        cast: cast.value.split("\n").map((line) => { const [name = "", roleName = "", lead = ""] = line.split("|").map((value) => value.trim()); return { name, roleName, isLead: /^(주연|yes|true|y|1)$/i.test(lead) }; }).filter((person) => person.name),
        characters: characters.value.split("\n").map((line) => { const [name = "", actor = "", ...description] = line.split("|").map((value) => value.trim()); return { name, actor, description: description.join(" | ") }; }).filter((person) => person.name || person.actor),
      };
      try {
        const response = await fetch("/api/admin/dramas", { method: idInput.value ? "PATCH" : "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
        const data = await response.json(); if (!response.ok) throw new Error(data.error);
        resetForm(); message.textContent = "저장되었습니다."; await loadSchedule();
      } catch (error) { message.textContent = error instanceof Error ? error.message : "저장하지 못했습니다."; }
      finally { button.disabled = false; }
    });
    resetButton.addEventListener("click", resetForm);
    yearToggle.addEventListener("click", () => {
      const willOpen = yearOptions.hidden;
      yearOptions.hidden = !willOpen;
      yearToggle.setAttribute("aria-expanded", String(willOpen));
    });
    yearOptions.addEventListener("change", renderWeeks);
    document.addEventListener("click", (event) => {
      if (!yearFilter.contains(event.target as Node)) {
        yearOptions.hidden = true;
        yearToggle.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        yearOptions.hidden = true;
        yearToggle.setAttribute("aria-expanded", "false");
      }
    });
    document.querySelector("#back-to-weeks")!.addEventListener("click", () => { resetForm(); loadWeeks(); });
    country.addEventListener("change", () => { resetForm(); loadWeeks(); });
    loadWeeks();
  </script>
</Layout>

<style is:global>
  main { min-height:100vh; background:radial-gradient(circle at 85% 0,rgba(116,35,28,.18),transparent 28%),#080a0d; }
  .admin-head,.admin-grid,.week-panel { max-width:1332px; margin:auto; }
  .admin-head { padding:72px 0 42px; display:flex; justify-content:space-between; align-items:end; border-bottom:1px solid #ffffff18; }
  .admin-head span,.section-title span { color:#c44a40; font-size:10px; letter-spacing:.18em; font-weight:700; }
  .admin-head h1 { margin:10px 0; font-size:44px; letter-spacing:-.04em; }
  .admin-head p { margin:0; color:#77736e; font-size:13px; }
  .admin-head label { color:#8c8780; font-size:11px; }
  .admin-head select { display:block; min-width:190px; margin-top:8px; padding:12px; color:#eee9e1; background:#111317; border:1px solid #ffffff20; }
  .admin-grid { display:grid; grid-template-columns:minmax(420px,.85fr) minmax(540px,1.15fr); gap:34px; padding:34px 0 90px; align-items:start; }
  .admin-grid[hidden] { display:none; }
  .week-panel { margin-top:34px;margin-bottom:90px;padding:28px;background:#101216;border:1px solid #ffffff12; }
  .week-tools{display:flex;align-items:center;gap:18px}.year-field{position:relative;display:grid;grid-template-columns:auto 320px auto;align-items:center;gap:8px;color:#8d8881;font-size:10px}.year-field>small{max-width:50px;color:#5f5b56;font-size:8px;line-height:1.35}
  .year-multiselect{position:relative}.year-multiselect>button{width:320px;min-height:46px;padding:7px 42px 7px 9px;border:1px solid #ffffff24;border-radius:4px;background:#090b0e;color:#eee9e1;text-align:left}.year-multiselect>button:focus,.year-multiselect>button[aria-expanded="true"]{border-color:#3b82f6;box-shadow:0 0 0 1px #3b82f6}.year-multiselect>button>span{display:flex;flex-wrap:wrap;gap:6px}.year-multiselect b{padding:5px 10px;border-radius:16px;background:#24272c;color:#eee9e1;font-size:11px;font-weight:500}.year-multiselect em{padding:5px;color:#68635d;font-style:normal}.year-multiselect i{position:absolute;right:16px;top:20px;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:0;border-top:7px solid #8d8881}.year-multiselect>button[aria-expanded="true"] i{transform:rotate(180deg)}
  .year-options{position:absolute;z-index:20;top:calc(100% + 5px);left:0;width:320px;max-height:310px;overflow-y:auto;border:1px solid #ffffff20;border-radius:4px;background:#171b21;box-shadow:0 16px 35px #0009}.year-options[hidden]{display:none}.year-options label{display:flex;align-items:center;gap:13px;padding:13px 18px;color:#ddd8d0;font-size:13px;cursor:pointer}.year-options label:hover{background:#252b34}.year-options input{width:17px;height:17px;margin:0;accent-color:#347fd1}
  .week-list { display:grid;gap:28px; }
  .year-group>h3{display:flex;align-items:baseline;gap:3px;margin:0 0 12px;color:#77736e;font-size:13px}.year-group>h3 span{color:#d7c0a0;font-size:24px}.year-group>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .week-card { display:grid;grid-template-columns:1fr auto;gap:8px;padding:20px;text-align:left;border:1px solid #ffffff12;background:#0b0d10;color:#f7f4ee; }
  .week-card:hover { border-color:#bd3e35;background:#121013; }.week-card span{color:#c44a40;font-size:9px;letter-spacing:.16em}.week-card strong{grid-column:1/-1;font-size:18px}.week-card small{color:#77736e}.week-card i{color:#c4aa84;font-size:10px;font-style:normal}
  .editor,.list-panel { padding:28px; background:#101216; border:1px solid #ffffff12; }
  .editor { position:sticky; top:20px; }
  .section-title { display:flex; justify-content:space-between; align-items:center; margin-bottom:25px; }
  .section-title h2 { margin:5px 0 0; font-size:21px; }
  .section-title strong { color:#8f8981; font-size:12px; }
  .list-heading-actions{display:flex;align-items:center;gap:12px}.list-heading-actions button{padding:8px 10px;border:1px solid #ffffff1b;background:#ffffff08;color:#aaa49d;font-size:10px}
  .fields { display:grid; gap:14px; margin-bottom:14px; }.fields.two{grid-template-columns:1fr 1fr}.fields.three{grid-template-columns:1fr 1fr 1fr}
  .editor label { display:block; color:#8d8881; font-size:11px; }
