---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="ON AIR — 카테고리별 TOP 10" description="최신 등록 콘텐츠를 카테고리별 TOP 10으로 만나보세요.">
  <main>
    <Header activePage="home" />
    <section class="hero">
      <div class="eyebrow"><span></span><span>NOW ON HAMS BROADCAST</span></div>
      <h1>새롭게 등록된<br /><em>오늘의 이야기</em><br />한눈에 만나보세요</h1>
      <div class="hero-meta"><p>한국영화부터 드라마, 예능, 애니메이션까지 카테고리별 최신 작품을 모았습니다.</p><div class="updated"><span class="pulse"></span><span>NEW CONTENT</span><span class="divider"></span><span id="updated-time">불러오는 중</span></div></div>
    </section>
    <div id="category-top-list" class="category-top-list" aria-live="polite"><div class="loading-message">카테고리별 TOP 10을 불러오고 있습니다.</div></div>
    <dialog class="catalog-detail" id="catalog-detail">
      <button class="detail-close" type="button" aria-label="상세정보 닫기">×</button>
      <div id="detail-content"></div>
    </dialog>
    <footer><a class="brand footer-brand" href="/"><span class="live-dot"></span>ON AIR</a><p>당신의 오늘에 좋은 이야기가 머물기를.</p><span>© 2026 HAMS BROADCAST</span></footer>
  </main>

  <script>
    interface TopItem { title?:string;thumbnailUrl?:string;genres?:string[];rating?:string|number;synopsis?:string;isUpdated?:boolean;itemDocumentId:string;catalogDocumentId:string;hasThumbnailImageData?:boolean; }
    interface TopCategory { category:string;title:string;items:TopItem[]; }
    const list=document.querySelector<HTMLElement>("#category-top-list")!;
    const refresh=document.querySelector<HTMLButtonElement>("#refresh");
    const country=document.querySelector<HTMLSelectElement>("#country");
    const flag=document.querySelector<HTMLElement>("#country-flag");
    const detail=document.querySelector<HTMLDialogElement>("#catalog-detail")!;
    const detailContent=document.querySelector<HTMLElement>("#detail-content")!;
    const flags:Record<string,string>={KR:"🇰🇷",US:"🇺🇸",JP:"🇯🇵",GB:"🇬🇧",FR:"🇫🇷",DE:"🇩🇪",ES:"🇪🇸",IT:"🇮🇹"};
    const safe=(value:unknown)=>String(value??"").replace(/[&<>'"]/g,(character)=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"})[character]||character);
    const thumbnail=(item:TopItem,category:string)=>item.hasThumbnailImageData?`/api/catalog/thumbnail?category=${encodeURIComponent(category)}&documentId=${encodeURIComponent(item.catalogDocumentId)}&itemId=${encodeURIComponent(item.itemDocumentId)}`:item.thumbnailUrl||"";
    function renderCategory(section:TopCategory,index:number){
      const cards=section.items.slice(0,10).map((item,itemIndex)=>{const image=thumbnail(item,section.category);const genres=Array.isArray(item.genres)?item.genres.slice(0,2).join(" · "):"";return `<article class="show-card"><button type="button" class="poster-wrap card-open" data-category="${safe(section.category)}" data-document-id="${safe(item.catalogDocumentId)}" data-item-id="${safe(item.itemDocumentId)}" data-title="${safe(item.title)}" data-poster="${safe(image)}" aria-label="${safe(item.title||"제목 없음")} 상세정보 보기">${image?`<img src="${safe(image)}" alt="${safe(item.title)}" loading="lazy">`:'<span class="poster-empty">NO IMAGE</span>'}<span class="rank">${String(itemIndex+1).padStart(2,"0")}</span>${item.isUpdated?'<span class="on-air"><i></i> UPDATE</span>':""}<span class="poster-shade"></span></button><div class="card-copy"><h3>${safe(item.title||"제목 없음")}</h3><div class="show-info"><span>${safe(genres||section.title)}</span><span>${item.rating?`★ ${safe(item.rating)}`:"NEW"}</span></div><p>${safe(item.synopsis||"")}</p></div></article>`;}).join("");
      return `<section class="shows" aria-labelledby="top-title-${index}"><div class="section-heading"><div><span class="section-no">${String(index+1).padStart(2,"0")}</span><h2 id="top-title-${index}">${safe(section.title)} <b>TOP 10</b></h2></div><div class="carousel-actions"><a href="/broadcasts?category=${encodeURIComponent(section.category)}">전체보기</a><button type="button" data-direction="previous" aria-label="이전 작품">←</button><button type="button" data-direction="next" aria-label="다음 작품">→</button></div></div>${cards?`<div class="show-grid">${cards}</div>`:'<div class="empty-message">등록된 작품이 없습니다.</div>'}</section>`;
    }
    function bindCarousels(){
      list.querySelectorAll<HTMLElement>(".shows").forEach((section)=>{
        const grid=section.querySelector<HTMLElement>(".show-grid");
        if(!grid)return;

        section.querySelectorAll<HTMLButtonElement>("[data-direction]").forEach((button)=>button.addEventListener("click",()=>{
          const card=grid.querySelector<HTMLElement>(".show-card");
          const gap=parseFloat(getComputedStyle(grid).columnGap)||0;
          const cardWidth=card?.getBoundingClientRect().width||grid.clientWidth/5;
          const visibleCards=window.matchMedia("(max-width: 520px)").matches?3:1;
          const distance=(cardWidth+gap)*visibleCards;
          grid.scrollBy({left:distance*(button.dataset.direction==="previous"?-1:1),behavior:"smooth"});
        }));

        let startX=0;
        let startScrollLeft=0;
        let dragged=false;
        grid.addEventListener("pointerdown",(event)=>{
          if(event.pointerType==="touch"||event.button!==0)return;
          startX=event.clientX;
          startScrollLeft=grid.scrollLeft;
          dragged=false;
          grid.classList.add("dragging");
          grid.setPointerCapture(event.pointerId);
        });
        grid.addEventListener("pointermove",(event)=>{
          if(!grid.hasPointerCapture(event.pointerId))return;
          const distance=event.clientX-startX;
          if(Math.abs(distance)>5)dragged=true;
          grid.scrollLeft=startScrollLeft-distance;
        });
        const stopDragging=(event:PointerEvent)=>{
          if(grid.hasPointerCapture(event.pointerId))grid.releasePointerCapture(event.pointerId);
          grid.classList.remove("dragging");
        };
        grid.addEventListener("pointerup",stopDragging);
        grid.addEventListener("pointercancel",stopDragging);
        grid.addEventListener("click",(event)=>{if(dragged){event.preventDefault();event.stopPropagation();dragged=false;}},true);
      });
    }
    async function openDetail(button:HTMLButtonElement){
      const title=button.dataset.title||"콘텐츠 상세정보";
      const poster=button.dataset.poster||"";
      detailContent.innerHTML='<div class="detail-loading"><span></span>상세정보를 불러오는 중</div>';
      detail.showModal();
      try{
        const response=await fetch(`/api/catalog/detail?category=${encodeURIComponent(button.dataset.category||"")}&documentId=${encodeURIComponent(button.dataset.documentId||"")}&itemId=${encodeURIComponent(button.dataset.itemId||"")}`);
        const data=await response.json();
        if(!response.ok)throw new Error(data.error||"상세정보 요청에 실패했습니다.");
        const info=Object.entries(data.information||{}).map(([label,value])=>`<div><dt>${safe(label)}</dt><dd>${safe(String(value))}</dd></div>`).join("");
        const people=data.cast?.length?data.cast:(data.characters||[]).map((person:{actor?:string;imageUrl?:string})=>({name:person.actor||"",imageUrl:person.imageUrl||""}));
        const cast=people.map((person:{name:string;imageUrl:string})=>`<li>${person.imageUrl?`<img src="${safe(person.imageUrl)}" alt="" loading="lazy">`:'<span class="cast-empty"></span>'}<strong>${safe(person.name)}</strong></li>`).join("");
        detailContent.innerHTML=`<div class="detail-layout"><div class="detail-poster"><img src="${safe(data.posterUrl||poster)}" alt="${safe(title)} 포스터"></div><div class="detail-copy"><span class="detail-kicker">DRAMA INFORMATION</span><h2>${safe(title)}</h2><div class="detail-genres">${(data.genres||[]).map((genre:string)=>`<span>${safe(genre)}</span>`).join("")}</div>${info?`<dl class="detail-info">${info}</dl>`:""}<h3>줄거리</h3><p>${safe(data.synopsis||"제공된 줄거리 정보가 없습니다.")}</p>${cast?`<h3>등장인물 · 출연진</h3><ul class="detail-cast">${cast}</ul>`:""}</div></div>`;
      }catch(error){
        detailContent.innerHTML=`<div class="detail-error"><strong>상세정보를 불러오지 못했습니다.</strong><p>${safe(error instanceof Error?error.message:"잠시 후 다시 시도해 주세요.")}</p></div>`;
      }
    }
    async function loadTopCategories(){refresh?.classList.add("loading");try{const response=await fetch("/api/catalog/top");const data=await response.json();if(!response.ok)throw new Error(data.error);list.innerHTML=(data.categories as TopCategory[]).map(renderCategory).join("");bindCarousels();document.querySelector<HTMLElement>("#updated-time")!.textContent=`${new Intl.DateTimeFormat("ko-KR",{hour:"2-digit",minute:"2-digit"}).format(new Date())} 업데이트`;}catch(error){list.innerHTML=`<div class="loading-message error">${safe(error instanceof Error?error.message:"TOP 10을 불러오지 못했습니다.")}</div>`;}finally{refresh?.classList.remove("loading");}}
    function setCountry(value:string){localStorage.setItem("hams-broadcast-country",value);if(country)country.value=value;if(flag)flag.textContent=flags[value]||"🇰🇷";}
    list.addEventListener("click",(event)=>{const button=(event.target as Element).closest<HTMLButtonElement>(".card-open");if(button)openDetail(button);});
    detail.querySelector<HTMLButtonElement>(".detail-close")!.addEventListener("click",()=>detail.close());
    detail.addEventListener("click",(event)=>{if(event.target===detail)detail.close();});
    const savedCountry=localStorage.getItem("hams-broadcast-country")||"KR";setCountry(flags[savedCountry]?savedCountry:"KR");country?.addEventListener("change",()=>setCountry(country.value));refresh?.addEventListener("click",loadTopCategories);loadTopCategories();
  </script>
</Layout>

<!-- 카드 목록은 클라이언트에서 동적으로 생성되므로 전역 스타일이어야 한다. -->
<style is:global>
  main{overflow:hidden;min-height:100vh;background:radial-gradient(circle at 78% 8%,rgba(116,35,28,.25),transparent 27%),#080a0d}.hero{position:relative;max-width:1440px;min-height:530px;margin:auto;padding:90px 54px 72px}.hero:after{content:"10";position:absolute;right:40px;top:-95px;color:transparent;font-size:500px;font-weight:800;line-height:1;letter-spacing:-.12em;-webkit-text-stroke:1px #ffffff0d;pointer-events:none}.eyebrow{display:flex;align-items:center;gap:14px;color:#a8a39b;font-size:11px;font-weight:700;letter-spacing:.18em}.eyebrow>span:first-child{width:33px;height:1px;background:#d1493e}h1{position:relative;z-index:1;max-width:800px;margin:32px 0 0;font-size:clamp(54px,6.5vw,96px);font-weight:700;line-height:.98;letter-spacing:-.065em}h1 em{color:#d7c0a0;font-family:Georgia,serif;font-weight:400}.hero-meta{position:absolute;right:54px;bottom:76px;width:320px}.hero-meta p{margin:0 0 24px;color:#a8a39b;font-size:14px;line-height:1.8}.updated{display:flex;align-items:center;gap:9px;color:#76736e;font-size:10px;letter-spacing:.1em}.pulse{width:6px;height:6px;border-radius:50%;background:#eb463b;box-shadow:0 0 0 4px #eb463b1a}.divider{width:1px;height:10px;background:#ffffff24}.category-top-list{max-width:1440px;margin:auto}.shows{padding:0 54px 90px}.section-heading{display:flex;align-items:end;justify-content:space-between;padding:30px 0 26px;border-top:1px solid #ffffff20}.section-heading>div{display:flex;align-items:center;gap:18px}.section-no{color:#e04b40;font-size:11px}.section-heading h2{margin:0;font-size:17px;letter-spacing:.03em}.section-heading h2 b{color:#8d8881;font-size:11px;letter-spacing:.12em}.carousel-actions a{color:#77736e;font-size:10px;text-decoration:none;letter-spacing:.08em}.carousel-actions a:hover{color:#f7f4ee}.carousel-actions button{width:36px;height:36px;border:1px solid #ffffff1f;background:#ffffff06;color:#eee;cursor:pointer}.carousel-actions button:hover{background:#ffffff12}.show-grid{display:grid;grid-auto-flow:column;grid-template-rows:minmax(0,1fr);grid-auto-columns:minmax(0,calc((100% - 60px)/5));gap:15px;overflow-x:auto;overflow-y:hidden;padding-bottom:20px;cursor:grab;touch-action:pan-x pan-y;user-select:none;scroll-snap-type:x mandatory;scrollbar-color:#a53e35 #17191d;scrollbar-width:thin}.show-grid.dragging{cursor:grabbing;scroll-snap-type:none}.show-grid.dragging .poster-wrap{pointer-events:none}.show-card{min-width:0;overflow:hidden;scroll-snap-align:start}.poster-wrap{position:relative;display:block;width:100%;padding:0;overflow:hidden;border:0;aspect-ratio:2/3;background:#17191d;color:inherit;text-align:left;cursor:pointer}.poster-wrap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;-webkit-user-drag:none;user-select:none;filter:saturate(.72);transition:transform .55s ease,filter .55s}.poster-empty{position:absolute;inset:0;display:grid;place-items:center;color:#77736e;font-size:11px;letter-spacing:.18em}.show-card:hover img{transform:scale(1.035);filter:saturate(1)}.poster-shade{position:absolute;inset:0;background:linear-gradient(180deg,#00000025 35%,#080a0dbb 100%)}.rank{position:absolute;z-index:1;top:10px;left:13px;color:#fff;font:italic 42px Georgia,serif;text-shadow:0 2px 15px #0008}.on-air{position:absolute;z-index:1;top:13px;right:10px;padding:6px 8px;background:#0b0d0fcc;font-size:8px;font-weight:700;letter-spacing:.12em}.on-air i{display:inline-block;width:5px;height:5px;margin-right:5px;border-radius:50%;background:#e54a3d}.card-copy{padding-top:17px}.card-copy h3{overflow:hidden;margin:0 0 9px;font-size:16px;line-height:1.3;text-overflow:ellipsis;white-space:nowrap}.show-info{display:flex;flex-wrap:wrap;color:#9a958d;font-size:10px}.show-info span+span:before{content:"·";margin:0 7px;color:#555}.show-info span:last-child{color:#c9a96e}.card-copy p{display:-webkit-box;overflow:hidden;margin:11px 0 0;color:#77736e;font-size:11px;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:2}.loading-message,.empty-message{padding:50px;color:#77736e;text-align:center}.loading-message.error{color:#d66c63}footer{display:flex;align-items:center;max-width:1332px;margin:auto;padding:33px 0 48px;border-top:1px solid #ffffff14;color:#56534f;font-size:10px;letter-spacing:.08em}footer p{margin:auto}.footer-brand{display:flex;align-items:center;gap:12px;color:#86817a;font-size:11px;text-decoration:none}.footer-brand .live-dot{width:6px;height:6px;border-radius:50%;background:#ec3a2f;box-shadow:0 0 16px #ec3a2f}
  .catalog-detail{width:min(980px,calc(100% - 32px));height:min(510px,88vh);padding:0;border:1px solid #ffffff20;background:#111317;color:#f7f4ee;overflow:hidden}.catalog-detail::backdrop{background:#000c;backdrop-filter:blur(5px)}.detail-close{position:fixed;z-index:3;margin:14px 0 0 min(920px,calc(100% - 78px));width:38px;height:38px;border:1px solid #ffffff25;background:#090b0ddd;color:#fff;font-size:24px;cursor:pointer}.catalog-detail #detail-content{height:100%;min-height:0}.detail-layout{display:grid;height:100%;min-height:0;grid-template-columns:340px 1fr}.detail-poster{display:grid;height:100%;min-height:0;place-items:center;overflow:hidden;background:#090b0e}.detail-poster img{display:block;width:auto;height:auto;max-width:100%;max-height:100%;object-fit:contain}.detail-copy{height:100%;min-height:0;padding:48px 46px;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#6d3934 #191b1f}.detail-kicker{color:#c64a40;font-size:9px;font-weight:800;letter-spacing:.18em}.detail-copy h2{margin:12px 0 14px;font-size:32px}.detail-genres{display:flex;flex-wrap:wrap;gap:6px}.detail-genres span{padding:6px 9px;background:#ffffff0a;color:#aaa49c;font-size:9px}.detail-info{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:26px 0;background:#ffffff10}.detail-info>div{padding:13px;background:#111317}.detail-info dt{color:#6f6b65;font-size:9px}.detail-info dd{margin:6px 0 0;color:#e3ded6;font-size:11px}.detail-copy h3{margin:28px 0 10px;color:#d7c0a0;font-size:11px}.detail-copy>p{margin:0;color:#aaa49c;font-size:13px;line-height:1.8}.detail-cast{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0;padding:0;list-style:none}.detail-cast li{min-width:0}.detail-cast img,.cast-empty{display:block;width:100%;aspect-ratio:1;object-fit:cover;background:#1a1c20}.detail-cast strong{display:block;overflow:hidden;margin-top:7px;font-size:10px;text-align:center;text-overflow:ellipsis;white-space:nowrap}.detail-loading,.detail-error{min-height:420px;display:grid;place-items:center;padding:50px;color:#77736e}.detail-loading span{width:22px;height:22px;border:2px solid #ffffff20;border-top-color:#bd3e35;border-radius:50%;animation:spin .8s linear infinite}.detail-error{text-align:center}@keyframes spin{to{transform:rotate(360deg)}}
  @media(max-width:900px){.hero{min-height:565px;padding:90px 24px 150px}.hero-meta{right:auto;bottom:42px;left:24px}.hero:after{right:-35px;font-size:330px}.shows{padding:0 24px 70px}.show-grid{grid-auto-columns:minmax(0,32%);gap:12px}footer{margin:0 24px}}
  @media(max-width:520px){.hero{padding-top:92px}h1{font-size:50px}.hero:after{font-size:240px}.show-grid{grid-auto-columns:calc((100% - 24px)/3);scroll-snap-stop:always}.show-card{width:100%}.section-heading>div{gap:10px}.carousel-actions{display:flex;align-items:center;gap:6px}.carousel-actions a{display:inline-flex;margin-right:2px;white-space:nowrap}.card-copy{padding-top:11px}.card-copy h3{margin-bottom:6px;font-size:13px}.show-info{font-size:9px}.show-info span:first-child{overflow:hidden;max-width:100%;text-overflow:ellipsis;white-space:nowrap}.show-info span:last-child{display:none}.card-copy p{display:none}.rank{top:7px;left:8px;font-size:27px}.on-air{top:8px;right:6px;padding:4px;font-size:0}.on-air i{margin:0}.carousel-actions button{width:34px;height:34px}footer p{display:none}.catalog-detail{height:auto;max-height:88vh;overflow:auto}.catalog-detail #detail-content{height:auto}.detail-layout{display:block;height:auto}.detail-poster{height:300px;min-height:0}.detail-poster img{object-fit:contain}.detail-copy{height:auto;padding:30px 22px;overflow:visible}.detail-info{grid-template-columns:1fr 1fr}.detail-cast{grid-template-columns:repeat(3,minmax(0,1fr))}.detail-close{right:24px;margin-left:0}}
</style>
