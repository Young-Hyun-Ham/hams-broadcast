---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
const fallbackShows: any[] = [];
---

<Layout>
  <main>
    <Header activePage="home" />
    <section class="hero">
      <div class="eyebrow">
        <span></span>
        <span data-i18n="eyebrow">지금, 우리 동네에서는</span>
      </div>
      <h1>
        <span data-i18n="headingA">오늘 밤,</span>
        <br />
        <em data-i18n="headingB">어떤 이야기를</em>
        <br />
        <span data-i18n="headingC">만나볼까요?</span>
      </h1>
      <div class="hero-meta">
        <p data-i18n="intro">
          현재 방영 중인 드라마 중 가장 주목받는 다섯 작품을 모았어요.
        </p>
        <div class="updated">
          <span class="pulse"></span>
          <span data-i18n="live">LIVE 편성</span>
          <span class="divider"></span>
          <span id="updated-time">--:-- 업데이트</span>
        </div>
      </div>
    </section>
    <section class="shows" aria-labelledby="list-title" aria-live="polite">
      <div class="section-heading">
        <div>
          <span class="section-no">01</span>
          <h2 id="list-title">
            <span id="country-name">대한민국</span>{" "}
            <span data-i18n="topFive">TOP 5</span>
          </h2>
        </div>
        <div class="carousel-actions">
          <p data-i18n="schedule">오늘의 방송 편성 기준</p>
          <button id="previous" aria-label="이전 작품">
            ←
          </button>
          <button id="next" aria-label="다음 작품">
            →
          </button>
        </div>
      </div>
      <div class="show-grid" id="show-grid">
        {fallbackShows.map((show, index) => (
          <article class="show-card">
            <div class="poster-wrap">
              <img
                src={show.image}
                alt={show.name}
                loading={index > 1 ? "lazy" : "eager"}
              />
              <span class="rank">{String(index + 1).padStart(2, "0")}</span>
              <span class="on-air">
                <i></i> ON AIR
              </span>
              <div class="poster-shade"></div>
            </div>
            <div class="card-copy">
              <h3>{show.name}</h3>
              <div class="show-info">
                <span>{show.network}</span>
                <span>{show.time}</span>
                <span>★ {show.rating}</span>
              </div>
              <p>{show.summary}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="error-message" id="error-message" hidden></div>
    </section>
    <footer>
      <a class="brand footer-brand" href="/">
        <span class="live-dot"></span>ON AIR
      </a>
      <p data-i18n="footer">당신의 오늘에 좋은 이야기가 머물기를.</p>
      <span>© 2026 HAMS BROADCAST</span>
    </footer>
  </main>
  <script define:vars={{ fallbackShows }}>
    const countries = {
      KR: {
        name: { ko: "대한민국", en: "South Korea", ja: "韓国" },
        flag: "🇰🇷",
      },
      US: {
        name: { ko: "미국", en: "United States", ja: "アメリカ" },
        flag: "🇺🇸",
      },
      JP: { name: { ko: "일본", en: "Japan", ja: "日本" }, flag: "🇯🇵" },
      GB: {
        name: { ko: "영국", en: "United Kingdom", ja: "イギリス" },
        flag: "🇬🇧",
      },
      FR: { name: { ko: "프랑스", en: "France", ja: "フランス" }, flag: "🇫🇷" },
      DE: { name: { ko: "독일", en: "Germany", ja: "ドイツ" }, flag: "🇩🇪" },
      ES: { name: { ko: "스페인", en: "Spain", ja: "スペイン" }, flag: "🇪🇸" },
      IT: { name: { ko: "이탈리아", en: "Italy", ja: "イタリア" }, flag: "🇮🇹" },
    };
    const messages = {
      ko: {
        homeMenu: "TOP 5",
        scheduleMenu: "전체 편성",
        countryLabel: "국가 선택",
        eyebrow: "지금, 우리 동네에서는",
        headingA: "오늘 밤,",
        headingB: "어떤 이야기를",
        headingC: "만나볼까요?",
        intro: "현재 방영 중인 드라마 중 가장 주목받는 다섯 작품을 모았어요.",
        live: "LIVE 편성",
        topFive: "TOP 5",
        schedule: "오늘의 방송 편성 기준",
        footer: "당신의 오늘에 좋은 이야기가 머물기를.",
        updated: "업데이트",
        empty: "오늘 등록된 드라마가 없어 추천작을 보여드려요.",
      },
      en: {
        homeMenu: "TOP 5",
        scheduleMenu: "FULL SCHEDULE",
        countryLabel: "Select country",
        eyebrow: "NOW, IN YOUR NEIGHBORHOOD",
        headingA: "What story",
        headingB: "will you discover",
        headingC: "tonight?",
        intro: "Five standout dramas airing in your country, all in one place.",
        live: "LIVE SCHEDULE",
        topFive: "TOP 5",
        schedule: "Based on today's broadcast schedule",
        footer: "May a good story stay with you today.",
        updated: "updated",
        empty: "No dramas are listed today, so we're showing our picks.",
      },
      ja: {
        homeMenu: "TOP 5",
        scheduleMenu: "全番組",
        countryLabel: "国を選択",
        eyebrow: "いま、あなたの街では",
        headingA: "今夜は、",
        headingB: "どんな物語に",
        headingC: "出会いますか？",
        intro: "現在放送中の注目ドラマを5作品集めました。",
        live: "放送中",
        topFive: "TOP 5",
        schedule: "本日の放送予定を基準",
        footer: "今日も素敵な物語と出会えますように。",
        updated: "更新",
        empty: "本日のドラマがないため、おすすめを表示します。",
      },
      fr: {
        homeMenu: "TOP 5",
        scheduleMenu: "PROGRAMME COMPLET",
        countryLabel: "Choisir un pays",
        eyebrow: "EN CE MOMENT, CHEZ VOUS",
        headingA: "Quelle histoire",
        headingB: "allez-vous découvrir",
        headingC: "ce soir ?",
        intro:
          "Cinq séries remarquables actuellement diffusées dans votre pays.",
        live: "PROGRAMME EN DIRECT",
        topFive: "TOP 5",
        schedule: "Selon le programme d’aujourd’hui",
        footer: "Qu’une belle histoire accompagne votre journée.",
        updated: "mis à jour",
        empty: "Aucune série aujourd’hui, voici notre sélection.",
      },
      de: {
        homeMenu: "TOP 5",
        scheduleMenu: "GESAMTES PROGRAMM",
        countryLabel: "Land auswählen",
        eyebrow: "JETZT IN DEINER NÄHE",
        headingA: "Welche Geschichte",
        headingB: "entdeckst du",
        headingC: "heute Abend?",
        intro: "Die fünf besten Serien, die derzeit in deinem Land laufen.",
        live: "LIVE-PROGRAMM",
        topFive: "TOP 5",
        schedule: "Nach dem heutigen Programm",
        footer: "Möge dich heute eine gute Geschichte begleiten.",
        updated: "aktualisiert",
        empty: "Heute sind keine Serien gelistet. Hier ist unsere Auswahl.",
      },
      es: {
        homeMenu: "TOP 5",
        scheduleMenu: "PROGRAMACIÓN",
        countryLabel: "Seleccionar país",
        eyebrow: "AHORA, CERCA DE TI",
        headingA: "¿Qué historia",
        headingB: "descubrirás",
        headingC: "esta noche?",
        intro: "Cinco series destacadas que se emiten actualmente en tu país.",
        live: "PROGRAMACIÓN EN DIRECTO",
        topFive: "TOP 5",
        schedule: "Según la programación de hoy",
        footer: "Que una buena historia te acompañe hoy.",
        updated: "actualizado",
        empty: "No hay series hoy; te mostramos nuestra selección.",
      },
      it: {
        homeMenu: "TOP 5",
        scheduleMenu: "PALINSESTO",
        countryLabel: "Seleziona paese",
        eyebrow: "ORA, VICINO A TE",
        headingA: "Quale storia",
        headingB: "scoprirai",
        headingC: "stasera?",
        intro: "Cinque serie imperdibili attualmente in onda nel tuo paese.",
        live: "PALINSESTO LIVE",
        topFive: "TOP 5",
        schedule: "In base al palinsesto di oggi",
        footer: "Che una bella storia accompagni la tua giornata.",
        updated: "aggiornato",
        empty: "Nessuna serie oggi: ecco i nostri consigli.",
      },
    };
    const localeMap = {
      ko: "KR",
      ja: "JP",
      en: "US",
      fr: "FR",
      de: "DE",
      es: "ES",
      it: "IT",
    };
    const countryLanguages = {
      KR: "ko",
      US: "en",
      JP: "ja",
      GB: "en",
      FR: "fr",
      DE: "de",
      ES: "es",
      IT: "it",
    };
    const locale = (navigator.language || "ko").slice(0, 2);
    const saved = localStorage.getItem("hams-broadcast-country");
    let country = saved && countries[saved] ? saved : localeMap[locale] || "US";
    let lang = countryLanguages[country];
    const grid = document.querySelector("#show-grid");
    const select = document.querySelector("#country");
    const refresh = document.querySelector("#refresh");
    const error = document.querySelector("#error-message");
    function translate() {
      document.documentElement.lang = lang;
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const value = messages[lang][el.dataset.i18n];
        if (value) el.textContent = value;
      });
    }
    function clean(value = "") {
      const temp = document.createElement("div");
      temp.innerHTML = value;
      return temp.textContent?.trim() || "";
    }
    function safe(value = "") {
      return String(value).replace(
        /[&<>'"]/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            "'": "&#39;",
            '"': "&quot;",
          })[c],
      );
    }
    function render(shows) {
      grid.innerHTML = shows
        .map(
          (item, i) =>
            `<article class="show-card"><div class="poster-wrap">${item.image ? `<img src="${safe(item.image)}" alt="${safe(item.name)}" loading="${i > 1 ? "lazy" : "eager"}">` : `<span class="poster-empty">ON AIR</span>`}<span class="rank">${String(i + 1).padStart(2, "0")}</span><span class="on-air"><i></i> ON AIR</span><div class="poster-shade"></div></div><div class="card-copy"><h3>${safe(item.name)}</h3><div class="show-info"><span>${safe(item.network)}</span><span>${safe(item.time || "—")}</span><span>${safe(item.rating || "방영 중")}</span></div><p>${safe(item.summary || "")}</p></div></article>`,
        )
        .join("");
    }
    async function loadShows() {
      refresh.classList.add("loading");
      error.hidden = true;
      grid.classList.add("updating");
      const date = new Intl.DateTimeFormat("en-CA", {
        timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      }).format(new Date());
      try {
        const response = await fetch(`/api/drama?country=${country}`);
        if (!response.ok) throw new Error();
        const weekly = await response.json();
        const shows = [...new Map((weekly.items || []).map((item) => [item.title, item])).values()]
          .sort((a, b) => String(a.airTime || "").localeCompare(String(b.airTime || "")))
          .slice(0, 5)
          .map((item) => ({
            name: item.title,
            network: item.broadcaster,
            time: item.airTime,
            rating: item.slot || "방영 중",
            image: item.thumbnailUrl,
            summary: item.characters?.map((character) => character.description).filter(Boolean).join(" ") || item.cast?.map((actor) => actor.name).filter(Boolean).join(", ") || "",
          }));
        if (shows.length) render(shows);
        else throw new Error();
      } catch (_) {
        render([]);
        error.textContent = messages[lang].empty;
        error.hidden = false;
      } finally {
        refresh.classList.remove("loading");
        grid.classList.remove("updating");
        document.querySelector("#updated-time").textContent =
          `${new Intl.DateTimeFormat(lang, { hour: "2-digit", minute: "2-digit" }).format(new Date())} ${messages[lang].updated}`;
      }
    }
    function setCountry(value) {
      country = value;
      lang = countryLanguages[country];
      localStorage.setItem("hams-broadcast-country", country);
      localStorage.setItem("hams-broadcast-locale", lang);
      translate();
      select.value = country;
      document.querySelector("#country-flag").textContent =
        countries[country].flag;
      document.querySelector("#country-name").textContent =
        select.options[select.selectedIndex].text;
      loadShows();
    }
    select.addEventListener("change", (e) => setCountry(e.target.value));
    refresh.addEventListener("click", loadShows);
    document
      .querySelector("#previous")
      .addEventListener("click", () =>
        grid.scrollBy({ left: -grid.clientWidth * 0.72, behavior: "smooth" }),
      );
    document
      .querySelector("#next")
      .addEventListener("click", () =>
        grid.scrollBy({ left: grid.clientWidth * 0.72, behavior: "smooth" }),
      );
    setCountry(country);
  </script>
</Layout>
<style>
  main {
    overflow: hidden;
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 78% 8%,
        rgba(116, 35, 28, 0.25),
        transparent 27%
      ),
      #080a0d;
  }
  .site-header {
    max-width: 1440px;
    height: 96px;
    margin: auto;
    padding: 0 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ffffff14;
  }
  .brand {
    color: #f7f4ee;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.22em;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ec3a2f;
    box-shadow: 0 0 16px #ec3a2f;
  }
  .main-nav {
    display: flex;
    gap: 30px;
    margin-left: auto;
    margin-right: 36px;
  }
  .main-nav a {
    color: #77736e;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 10px 0;
    border-bottom: 1px solid transparent;
  }
  .main-nav a:hover,
  .main-nav a.active {
    color: #f7f4ee;
    border-color: #e04b40;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .country-select {
    height: 44px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 13px;
    border: 1px solid #ffffff20;
    border-radius: 4px;
    background: #ffffff08;
  }
  .country-select select {
    color: #e6e1d9;
    border: 0;
    outline: 0;
    background: transparent;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }
  .country-select select option {
    background: #181a1d;
  }
  .country-select svg {
    width: 14px;
  }
  .icon-button {
    width: 44px;
    height: 44px;
    border: 1px solid #ffffff20;
    border-radius: 4px;
    background: #ffffff08;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .icon-button svg {
    width: 19px;
  }
  .icon-button.loading svg {
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero {
    max-width: 1440px;
    margin: auto;
    min-height: 530px;
    padding: 90px 54px 72px;
    position: relative;
  }
  .hero:after {
    content: "5";
    position: absolute;
    right: 40px;
    top: -115px;
    font-size: 570px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.1em;
    color: transparent;
    -webkit-text-stroke: 1px #ffffff0d;
    pointer-events: none;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #a8a39b;
    letter-spacing: 0.18em;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .eyebrow > span:first-child {
    display: block;
    width: 33px;
    height: 1px;
    background: #d1493e;
  }
  h1 {
    position: relative;
    z-index: 1;
    margin: 32px 0 0;
    max-width: 760px;
    font-size: clamp(54px, 6.5vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.065em;
    font-weight: 700;
  }
  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: #d7c0a0;
  }
  .hero-meta {
    position: absolute;
    right: 54px;
    bottom: 76px;
    width: 300px;
  }
  .hero-meta p {
    color: #a8a39b;
    font-size: 14px;
    line-height: 1.8;
    margin: 0 0 24px;
  }
  .updated {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #76736e;
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .pulse {
    width: 6px;
    height: 6px;
    background: #eb463b;
    border-radius: 50%;
    box-shadow: 0 0 0 4px #eb463b1a;
  }
  .divider {
    width: 1px;
    height: 10px;
    background: #ffffff24;
  }
  .shows {
    max-width: 1440px;
    margin: auto;
    padding: 0 54px 105px;
  }
  .section-heading {
    border-top: 1px solid #ffffff20;
    padding: 30px 0 26px;
    display: flex;
    justify-content: space-between;
    align-items: end;
  }
  .section-heading > div {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .section-no {
    color: #e04b40;
    font-size: 11px;
  }
  .section-heading h2 {
    font-size: 17px;
    letter-spacing: 0.03em;
    margin: 0;
  }
  .section-heading p {
    font-size: 11px;
    color: #77736e;
    margin: 0;
    letter-spacing: 0.08em;
  }
  .carousel-actions button {
    width: 36px;
    height: 36px;
    border: 1px solid #ffffff1f;
    background: #ffffff06;
    cursor: pointer;
  }
  .carousel-actions button:hover {
    background: #ffffff12;
  }
  .show-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, calc((100% - 45px) / 3.7));
    gap: 15px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: #a53e35 #17191d;
    padding-bottom: 20px;
    transition: opacity 0.25s;
  }
  :global(.show-card) {
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
  }
  .show-grid.updating {
    opacity: 0.38;
  }
  :global(.poster-wrap) {
    position: relative;
    width: 100%;
    aspect-ratio: 2/3;
    overflow: hidden;
    background: #17191d;
  }
  :global(.poster-wrap img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.72);
    transition:
      transform 0.55s ease,
      filter 0.55s;
  }
  :global(.poster-empty) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #77736e;
    font-size: 11px;
    letter-spacing: 0.18em;
  }
  :global(.show-card:hover img) {
    transform: scale(1.035);
    filter: saturate(1);
  }
  :global(.poster-shade) {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #00000025 35%, #080a0dbb 100%);
  }
  :global(.rank) {
    position: absolute;
    left: 13px;
    top: 10px;
    font:
      italic 42px Georgia,
      serif;
    color: #fff;
    text-shadow: 0 2px 15px #0008;
    z-index: 1;
  }
  :global(.on-air) {
    position: absolute;
    right: 10px;
    top: 13px;
    background: #0b0d0fcc;
    padding: 6px 8px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
    z-index: 1;
  }
  :global(.on-air i) {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e54a3d;
    margin-right: 5px;
  }
  :global(.card-copy) {
    padding-top: 17px;
  }
  :global(.card-copy h3) {
    margin: 0 0 9px;
    font-size: 16px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.show-info) {
    display: flex;
    flex-wrap: wrap;
    color: #9a958d;
    font-size: 10px;
  }
  :global(.show-info span + span:before) {
    content: "·";
    margin: 0 7px;
    color: #555;
  }
  :global(.show-info span:last-child) {
    color: #c9a96e;
  }
  :global(.card-copy p) {
    color: #77736e;
    font-size: 11px;
    line-height: 1.65;
    margin: 11px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .error-message {
    margin-top: 18px;
    color: #8e8982;
    font-size: 12px;
  }
  footer {
    max-width: 1332px;
    margin: auto;
    border-top: 1px solid #ffffff14;
    padding: 33px 0 48px;
    display: flex;
    align-items: center;
    color: #56534f;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  footer p {
    margin: auto;
  }
  .footer-brand {
    font-size: 11px;
    color: #86817a;
  }
  .footer-brand .live-dot {
    width: 6px;
    height: 6px;
