---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="ON AIR — 카테고리별 TOP 10" description="최신 등록 콘텐츠를 카테고리별 TOP 10으로 만나보세요.">
  <main>
    <Header activePage="home" />
    <section class="hero">
      <div class="eyebrow"><span></span><span>NOW ON HAMS BROADCAST</span></div>
      <h1>새롭게 등록된<br /><em>오늘의 이야기</em><br />한눈에 만나보세요</h1>
      <div class="hero-meta"><p>한국영화부터 드라마, 예능, 애니메이션까지 카테고리별 최신 작품을 모았습니다.</p><div class="updated"><span class="pulse"></span><span>NEW CONTENT</span><span class="divider"></span><span id="updated-time">불러오는 중</span></div></div>
    </section>
    <div id="category-top-list" class="category-top-list" aria-live="polite"><div class="loading-message">카테고리별 TOP 10을 불러오고 있습니다.</div></div>
    <footer><a class="brand footer-brand" href="/"><span class="live-dot"></span>ON AIR</a><p>당신의 오늘에 좋은 이야기가 머물기를.</p><span>© 2026 HAMS BROADCAST</span></footer>
  </main>

  <script>
    interface TopItem { title?:string;thumbnailUrl?:string;genres?:string[];rating?:string|number;synopsis?:string;isUpdated?:boolean;itemDocumentId:string;catalogDocumentId:string;hasThumbnailImageData?:boolean; }
    interface TopCategory { category:string;title:string;items:TopItem[]; }
    const list=document.querySelector<HTMLElement>("#category-top-list")!;
    const refresh=document.querySelector<HTMLButtonElement>("#refresh");
    const country=document.querySelector<HTMLSelectElement>("#country");
    const flag=document.querySelector<HTMLElement>("#country-flag");
    const flags:Record<string,string>={KR:"🇰🇷",US:"🇺🇸",JP:"🇯🇵",GB:"🇬🇧",FR:"🇫🇷",DE:"🇩🇪",ES:"🇪🇸",IT:"🇮🇹"};
    const safe=(value:unknown)=>String(value??"").replace(/[&<>'"]/g,(character)=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"})[character]||character);
    const thumbnail=(item:TopItem,category:string)=>item.hasThumbnailImageData?`/api/catalog/thumbnail?category=${encodeURIComponent(category)}&documentId=${encodeURIComponent(item.catalogDocumentId)}&itemId=${encodeURIComponent(item.itemDocumentId)}`:item.thumbnailUrl||"";
    function renderCategory(section:TopCategory,index:number){
      const cards=section.items.map((item,itemIndex)=>{const image=thumbnail(item,section.category);const genres=Array.isArray(item.genres)?item.genres.slice(0,2).join(" · "):"";return `<article class="show-card"><a class="poster-wrap" href="/broadcasts?category=${encodeURIComponent(section.category)}">${image?`<img src="${safe(image)}" alt="${safe(item.title)}" loading="lazy">`:'<span class="poster-empty">NO IMAGE</span>'}<span class="rank">${String(itemIndex+1).padStart(2,"0")}</span>${item.isUpdated?'<span class="on-air"><i></i> UPDATE</span>':""}<span class="poster-shade"></span></a><div class="card-copy"><h3>${safe(item.title||"제목 없음")}</h3><div class="show-info"><span>${safe(genres||section.title)}</span><span>${item.rating?`★ ${safe(item.rating)}`:"NEW"}</span></div><p>${safe(item.synopsis||"")}</p></div></article>`;}).join("");
      return `<section class="shows" aria-labelledby="top-title-${index}"><div class="section-heading"><div><span class="section-no">${String(index+1).padStart(2,"0")}</span><h2 id="top-title-${index}">${safe(section.title)} <b>TOP 10</b></h2></div><div class="carousel-actions"><a href="/broadcasts?category=${encodeURIComponent(section.category)}">전체보기</a><button type="button" data-direction="previous" aria-label="이전 작품">←</button><button type="button" data-direction="next" aria-label="다음 작품">→</button></div></div>${cards?`<div class="show-grid">${cards}</div>`:'<div class="empty-message">등록된 작품이 없습니다.</div>'}</section>`;
    }
    function bindCarousels(){list.querySelectorAll<HTMLElement>(".shows").forEach((section)=>{const grid=section.querySelector<HTMLElement>(".show-grid");section.querySelectorAll<HTMLButtonElement>("[data-direction]").forEach((button)=>button.addEventListener("click",()=>{if(grid)grid.scrollBy({left:grid.clientWidth*(button.dataset.direction==="previous"?-.72:.72),behavior:"smooth"});}));});}
    async function loadTopCategories(){refresh?.classList.add("loading");try{const response=await fetch("/api/catalog/top");const data=await response.json();if(!response.ok)throw new Error(data.error);list.innerHTML=(data.categories as TopCategory[]).map(renderCategory).join("");bindCarousels();document.querySelector<HTMLElement>("#updated-time")!.textContent=`${new Intl.DateTimeFormat("ko-KR",{hour:"2-digit",minute:"2-digit"}).format(new Date())} 업데이트`;}catch(error){list.innerHTML=`<div class="loading-message error">${safe(error instanceof Error?error.message:"TOP 10을 불러오지 못했습니다.")}</div>`;}finally{refresh?.classList.remove("loading");}}
    function setCountry(value:string){localStorage.setItem("hams-broadcast-country",value);if(country)country.value=value;if(flag)flag.textContent=flags[value]||"🇰🇷";}
    const savedCountry=localStorage.getItem("hams-broadcast-country")||"KR";setCountry(flags[savedCountry]?savedCountry:"KR");country?.addEventListener("change",()=>setCountry(country.value));refresh?.addEventListener("click",loadTopCategories);loadTopCategories();
  </script>
</Layout>

<style>
  main{overflow:hidden;min-height:100vh;background:radial-gradient(circle at 78% 8%,rgba(116,35,28,.25),transparent 27%),#080a0d}.hero{position:relative;max-width:1440px;min-height:530px;margin:auto;padding:90px 54px 72px}.hero:after{content:"10";position:absolute;right:40px;top:-95px;color:transparent;font-size:500px;font-weight:800;line-height:1;letter-spacing:-.12em;-webkit-text-stroke:1px #ffffff0d;pointer-events:none}.eyebrow{display:flex;align-items:center;gap:14px;color:#a8a39b;font-size:11px;font-weight:700;letter-spacing:.18em}.eyebrow>span:first-child{width:33px;height:1px;background:#d1493e}h1{position:relative;z-index:1;max-width:800px;margin:32px 0 0;font-size:clamp(54px,6.5vw,96px);font-weight:700;line-height:.98;letter-spacing:-.065em}h1 em{color:#d7c0a0;font-family:Georgia,serif;font-weight:400}.hero-meta{position:absolute;right:54px;bottom:76px;width:320px}.hero-meta p{margin:0 0 24px;color:#a8a39b;font-size:14px;line-height:1.8}.updated{display:flex;align-items:center;gap:9px;color:#76736e;font-size:10px;letter-spacing:.1em}.pulse{width:6px;height:6px;border-radius:50%;background:#eb463b;box-shadow:0 0 0 4px #eb463b1a}.divider{width:1px;height:10px;background:#ffffff24}.category-top-list{max-width:1440px;margin:auto}.shows{padding:0 54px 90px}.section-heading{display:flex;align-items:end;justify-content:space-between;padding:30px 0 26px;border-top:1px solid #ffffff20}.section-heading>div{display:flex;align-items:center;gap:18px}.section-no{color:#e04b40;font-size:11px}.section-heading h2{margin:0;font-size:17px;letter-spacing:.03em}.section-heading h2 b{color:#8d8881;font-size:11px;letter-spacing:.12em}.carousel-actions a{color:#77736e;font-size:10px;text-decoration:none;letter-spacing:.08em}.carousel-actions a:hover{color:#f7f4ee}.carousel-actions button{width:36px;height:36px;border:1px solid #ffffff1f;background:#ffffff06;color:#eee;cursor:pointer}.carousel-actions button:hover{background:#ffffff12}.show-grid{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,calc((100% - 60px)/5));gap:15px;overflow-x:auto;padding-bottom:20px;scroll-snap-type:x mandatory;scrollbar-color:#a53e35 #17191d;scrollbar-width:thin}.show-card{min-width:0;overflow:hidden;scroll-snap-align:start}.poster-wrap{position:relative;display:block;width:100%;overflow:hidden;aspect-ratio:2/3;background:#17191d}.poster-wrap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.72);transition:transform .55s ease,filter .55s}.poster-empty{position:absolute;inset:0;display:grid;place-items:center;color:#77736e;font-size:11px;letter-spacing:.18em}.show-card:hover img{transform:scale(1.035);filter:saturate(1)}.poster-shade{position:absolute;inset:0;background:linear-gradient(180deg,#00000025 35%,#080a0dbb 100%)}.rank{position:absolute;z-index:1;top:10px;left:13px;color:#fff;font:italic 42px Georgia,serif;text-shadow:0 2px 15px #0008}.on-air{position:absolute;z-index:1;top:13px;right:10px;padding:6px 8px;background:#0b0d0fcc;font-size:8px;font-weight:700;letter-spacing:.12em}.on-air i{display:inline-block;width:5px;height:5px;margin-right:5px;border-radius:50%;background:#e54a3d}.card-copy{padding-top:17px}.card-copy h3{overflow:hidden;margin:0 0 9px;font-size:16px;line-height:1.3;text-overflow:ellipsis;white-space:nowrap}.show-info{display:flex;flex-wrap:wrap;color:#9a958d;font-size:10px}.show-info span+span:before{content:"·";margin:0 7px;color:#555}.show-info span:last-child{color:#c9a96e}.card-copy p{display:-webkit-box;overflow:hidden;margin:11px 0 0;color:#77736e;font-size:11px;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:2}.loading-message,.empty-message{padding:50px;color:#77736e;text-align:center}.loading-message.error{color:#d66c63}footer{display:flex;align-items:center;max-width:1332px;margin:auto;padding:33px 0 48px;border-top:1px solid #ffffff14;color:#56534f;font-size:10px;letter-spacing:.08em}footer p{margin:auto}.footer-brand{display:flex;align-items:center;gap:12px;color:#86817a;font-size:11px;text-decoration:none}.footer-brand .live-dot{width:6px;height:6px;border-radius:50%;background:#ec3a2f;box-shadow:0 0 16px #ec3a2f}
  @media(max-width:900px){.hero{min-height:565px;padding:90px 24px 150px}.hero-meta{right:auto;bottom:42px;left:24px}.hero:after{right:-35px;font-size:330px}.shows{padding:0 24px 70px}.show-grid{grid-auto-columns:minmax(0,32%);gap:12px}footer{margin:0 24px}}
  @media(max-width:520px){.hero{padding-top:92px}h1{font-size:50px}.hero:after{font-size:240px}.show-grid{grid-auto-columns:minmax(0,58%)}.section-heading>div{gap:10px}.carousel-actions a{display:none}.card-copy p{display:none}.rank{font-size:34px}footer p{display:none}}
</style>
